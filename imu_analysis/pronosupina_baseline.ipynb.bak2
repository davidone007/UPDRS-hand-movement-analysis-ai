   "metadata": {
    "cell_id": "19c6f310c2cd4e0a97de3ffcb4703c36",
    "deepnote_block_group": "e97965495219495fb2b3e14db9fc6571",
    "deepnote_cell_type": "code",
    "deepnote_content_hash": "44ea4145",
