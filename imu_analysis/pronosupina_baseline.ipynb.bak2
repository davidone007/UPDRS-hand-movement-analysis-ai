    "deepnote_execution_started_at": "2026-02-26T23:07:38.129Z",
    "deepnote_sorting_key": "0",
    "deepnote_source": "\"\"\"\n============================================================================\nANÁLISIS BASELINE COMPLETO: PRONACIÓN-SUPINACIÓN CON DETECCIÓN MEJORADA\n============================================================================\nPropósito: Crear referencia de normalidad con detección robusta de ciclos\n============================================================================\n\"\"\"\n\nimport json\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.signal import butter, filtfilt, find_peaks\nfrom scipy.fft import fft, fftfreq\nimport os\nfrom datetime import datetime\nimport pandas as pd\n\n\n# ========================================\n# 1. CONFIGURACIÓN GENERAL\n# ========================================\nclass ConfigBaseline:\n    \"\"\"Configuración para análisis de baseline\"\"\"\n    \n    # Parámetros de filtrado\n    FS = 100  # Frecuencia de muestreo [Hz]\n    GYRO_LOWCUT = 0.3   # Hz (elimina drift)\n    GYRO_HIGHCUT = 10.0  # Hz (elimina ruido alta frecuencia)\n    ACCEL_CUTOFF = 5.0   # Hz (suaviza acelerómetro)\n    \n    # Detección de ciclos - PARÁMETROS AJUSTABLES\n    PICO_PROMINENCE_FACTOR = 0.15  # % del rango (15% del rango total)\n    PICO_HEIGHT_FACTOR_POS = 0.15   # % del máximo para picos positivos\n    PICO_HEIGHT_FACTOR_NEG = 0.15   # % del máximo para picos negativos\n    PICO_MIN_DISTANCE = 15          # muestras mínimas entre picos\n    PICO_WIDTH = 5                  # ancho mínimo del pico\n    \n    # Umbrales para datos válidos\n    CICLOS_MIN_VALIDOS = 10    # Mínimo de ciclos para análisis\n    DURACION_MINIMA = 2.0     # segundos mínimos\n    \n    # Carpetas\n    OUTPUT_BASE = \"/work/Pronacion Supinacion/baseline\"\n    OUTPUT_INDIVIDUAL = \"/work/Pronacion Supinacion/baseline/individual\"\n    OUTPUT_SUMMARY = \"/work/Pronacion Supinacion/baseline/summary\"\n\n# ========================================\n# 2. FUNCIONES DE DETECCIÓN DE PRUEBA\n# ========================================\ndef detectar_tipo_prueba(archivo_path, imu_data):\n    \"\"\"\n    Detecta automáticamente el tipo de prueba basado en:\n    1. Nombre del archivo\n    2. Dispositivos presentes en los datos\n    \"\"\"\n    archivo_nombre = os.path.basename(archivo_path).lower()\n    \n    # Extraer dispositivos únicos\n    dispositivos = set()\n    for dato in imu_data:\n        if \"deviceId\" in dato:\n            dispositivos.add(dato[\"deviceId\"])\n    \n    # Determinar tipo de prueba\n    if \"right\" in archivo_nombre or \"derecha\" in archivo_nombre:\n        return \"right_only\", \"Mano derecha única\", list(dispositivos)\n    elif \"left\" in archivo_nombre or \"izquierda\" in archivo_nombre:\n        return \"left_only\", \"Mano izquierda única\", list(dispositivos)\n    elif \"both\" in archivo_nombre or \"ambas\" in archivo_nombre:\n        return \"both_hands\", \"Ambas manos\", list(dispositivos)\n    elif len(dispositivos) == 1:\n        return \"single_hand\", \"Mano única (detectada)\", list(dispositivos)\n    elif len(dispositivos) > 1:\n        return \"both_hands\", \"Ambas manos (detectada)\", list(dispositivos)\n    else:\n        return \"unknown\", \"Tipo desconocido\", list(dispositivos)\n\ndef separar_por_dispositivo(imu_data):\n    \"\"\"Separa datos por dispositivo\"\"\"\n    dispositivos = {}\n    for dato in imu_data:\n        device_id = dato.get(\"deviceId\", \"unknown\")\n        if device_id not in dispositivos:\n            dispositivos[device_id] = []\n        dispositivos[device_id].append(dato)\n    return dispositivos\n\n# ========================================\n# 3. FUNCIONES DE PROCESAMIENTO\n# ========================================\ndef procesar_dispositivo_baseline(datos, nombre_dispositivo, config):\n    \"\"\"Procesa un dispositivo IMU para análisis baseline\"\"\"\n    \n    # Extraer timestamps\n    time = np.array([d[\"timestamp\"] for d in datos])\n    time = (time - time[0]) / 1000.0  # Convertir a segundos\n    \n    # Extraer giroscopio\n    gx = np.array([d.get(\"gyroscope\", {}).get(\"x\", 0) for d in datos])\n    gy = np.array([d.get(\"gyroscope\", {}).get(\"y\", 0) for d in datos])\n    gz = np.array([d.get(\"gyroscope\", {}).get(\"z\", 0) for d in datos])\n    \n    # Extraer acelerómetro\n    ax = np.array([d.get(\"accelerometer\", {}).get(\"x\", 0) for d in datos])\n    ay = np.array([d.get(\"accelerometer\", {}).get(\"y\", 0) for d in datos])\n    az = np.array([d.get(\"accelerometer\", {}).get(\"z\", 0) for d in datos])\n    \n    # Función filtro pasa-banda\n    def butter_bandpass(data, lowcut, highcut, fs, order=4):\n        nyq = 0.5 * fs\n        low = lowcut / nyq\n        high = highcut / nyq\n        b, a = butter(order, [low, high], btype='band')\n        return filtfilt(b, a, data)\n    \n    # Función filtro pasa-bajos\n    def butter_lowpass(data, cutoff, fs, order=4):\n        nyq = 0.5 * fs\n        normal_cutoff = cutoff / nyq\n        b, a = butter(order, normal_cutoff, btype='low')\n        return filtfilt(b, a, data)\n    \n    # Aplicar filtros\n    gx_filt = butter_bandpass(gx, config.GYRO_LOWCUT, config.GYRO_HIGHCUT, config.FS)\n    gy_filt = butter_bandpass(gy, config.GYRO_LOWCUT, config.GYRO_HIGHCUT, config.FS)\n    gz_filt = butter_bandpass(gz, config.GYRO_LOWCUT, config.GYRO_HIGHCUT, config.FS)\n    \n    ax_filt = butter_lowpass(ax, config.ACCEL_CUTOFF, config.FS)\n    ay_filt = butter_lowpass(ay, config.ACCEL_CUTOFF, config.FS)\n    az_filt = butter_lowpass(az, config.ACCEL_CUTOFF, config.FS)\n    \n    return {\n        'time': time,\n        'gx_raw': gx, 'gy_raw': gy, 'gz_raw': gz,\n        'ax_raw': ax, 'ay_raw': ay, 'az_raw': az,\n        'gx': gx_filt, 'gy': gy_filt, 'gz': gz_filt,\n        'ax': ax_filt, 'ay': ay_filt, 'az': az_filt,\n        'device_id': nombre_dispositivo\n    }\n\n# ========================================\n# 4. DETECCIÓN MEJORADA DE CICLOS\n# ========================================\ndef detectar_ciclos_mejorado(gx_signal, time_signal, config, debug=False):\n    \"\"\"\n    Detección mejorada de ciclos de pronación-supinación\n    con múltiples estrategias para capturar todos los picos\n    \"\"\"\n    \n    # ESTRATEGIA 1: Detección por prominencia (más robusta)\n    rango_senal = np.max(gx_signal) - np.min(gx_signal)\n    prominence_min = rango_senal * config.PICO_PROMINENCE_FACTOR\n    \n    # Detectar picos positivos (pronación)\n    picos_pos, propiedades_pos = find_peaks(\n        gx_signal,\n        prominence=prominence_min,\n        height=np.max(gx_signal) * config.PICO_HEIGHT_FACTOR_POS,\n        distance=config.PICO_MIN_DISTANCE,\n        width=config.PICO_WIDTH\n    )\n    \n    # Detectar picos negativos (supinación)\n    picos_neg, propiedades_neg = find_peaks(\n        -gx_signal,  # Invertir señal para detectar mínimos\n        prominence=prominence_min,\n        height=-np.min(gx_signal) * config.PICO_HEIGHT_FACTOR_NEG,\n        distance=config.PICO_MIN_DISTANCE,\n        width=config.PICO_WIDTH\n    )\n    \n    # ESTRATEGIA 2: Si no detecta suficientes picos, usar umbral más bajo\n    if len(picos_pos) < 3 or len(picos_neg) < 3:\n        if debug:\n            print(f\"  ⚠️  Pocos picos detectados ({len(picos_pos)} pos, {len(picos_neg)} neg)\")\n            print(f\"     Intentando con umbrales más bajos...\")\n        \n        # Reducir umbrales\n        altura_min_pos_2 = np.max(gx_signal) * (config.PICO_HEIGHT_FACTOR_POS * 0.5)\n        altura_min_neg_2 = -np.min(gx_signal) * (config.PICO_HEIGHT_FACTOR_NEG * 0.5)\n        \n        picos_pos_2, _ = find_peaks(\n            gx_signal,\n            height=altura_min_pos_2,\n            distance=config.PICO_MIN_DISTANCE\n        )\n        \n        picos_neg_2, _ = find_peaks(\n            -gx_signal,\n            height=altura_min_neg_2,\n            distance=config.PICO_MIN_DISTANCE\n        )\n        \n        # Usar el conjunto con más picos\n        if len(picos_pos_2) > len(picos_pos):\n            picos_pos = picos_pos_2\n        if len(picos_neg_2) > len(picos_neg):\n            picos_neg = picos_neg_2\n    \n    # ESTRATEGIA 3: Asegurar alternancia de picos\n    todos_picos = []\n    for p in picos_pos:\n        todos_picos.append(('pos', p, gx_signal[p]))\n    for p in picos_neg:\n        todos_picos.append(('neg', p, gx_signal[p]))\n    \n    # Ordenar por tiempo\n    todos_picos.sort(key=lambda x: x[1])\n    \n    # Filtrar para asegurar alternancia pos-neg-pos-neg\n    picos_filtrados_pos = []\n    picos_filtrados_neg = []\n    ultimo_tipo = None\n    \n    for tipo, idx, valor in todos_picos:\n        if ultimo_tipo is None or tipo != ultimo_tipo:\n            if tipo == 'pos':\n                picos_filtrados_pos.append(idx)\n            else:\n                picos_filtrados_neg.append(idx)\n            ultimo_tipo = tipo\n    \n    # Convertir a arrays\n    picos_pos = np.array(picos_filtrados_pos)\n    picos_neg = np.array(picos_filtrados_neg)\n    \n    # Calcular número de ciclos completos\n    n_ciclos = min(len(picos_pos), len(picos_neg))\n    \n    if debug:\n        print(f\"  ✓ Picos positivos detectados: {len(picos_pos)}\")\n        print(f\"  ✓ Picos negativos detectados: {len(picos_neg)}\")\n        print(f\"  ✓ Ciclos completos: {n_ciclos}\")\n        \n        if n_ciclos > 0:\n            if len(picos_pos) > 1:\n                tiempos_pos = np.diff(time_signal[picos_pos])\n                print(f\"  ⏱️  Tiempo entre pronaciones: {np.mean(tiempos_pos):.2f} ± {np.std(tiempos_pos):.2f} s\")\n            \n            if len(picos_neg) > 1:\n                tiempos_neg = np.diff(time_signal[picos_neg])\n                print(f\"  ⏱️  Tiempo entre supinaciones: {np.mean(tiempos_neg):.2f} ± {np.std(tiempos_neg):.2f} s\")\n    \n    return picos_pos, picos_neg, n_ciclos\n\n# ========================================\n# 5. ANÁLISIS DE VARIABLES OBJETIVAS\n# ========================================\ndef analizar_variables_baseline(procesado, debug=False):\n    \"\"\"\n    Extrae variables objetivas para baseline con detección mejorada\n    \"\"\"\n    time = procesado['time']\n    ax = procesado['ax']\n    ay = procesado['ay']\n    az = procesado['az']\n    gx = procesado['gx']\n    gy = procesado['gy']\n    gz = procesado['gz']\n\n    dt = np.mean(np.diff(time)) if len(time) > 1 else 1 / ConfigBaseline.FS\n    \n    # 1. Detección MEJORADA de ciclos\n    picos_pos, picos_neg, n_ciclos = detectar_ciclos_mejorado(\n        gx, time, ConfigBaseline, debug=debug\n    )\n    \n    # 2. Calcular amplitudes por ciclo\n    amplitudes = []\n    tiempos_ciclo = []\n    \n    if n_ciclos > 0:\n        for i in range(n_ciclos):\n            if i < len(picos_pos) and i < len(picos_neg):\n                idx_pos = picos_pos[i]\n                idx_neg = picos_neg[i]\n                \n                # Amplitud del ciclo\n                amp = abs(gx[idx_pos] - gx[idx_neg])\n                amplitudes.append(amp)\n                \n                # Tiempo del ciclo\n                tiempos_ciclo.append(time[idx_pos])\n    \n    # 3. Calcular velocidades pico\n    velocidades_pico = []\n    for pico in picos_pos:\n        velocidades_pico.append(abs(gx[pico]))\n    for pico in picos_neg:\n        velocidades_pico.append(abs(gx[pico]))\n    \n    # 4. Análisis de frecuencia (FFT)\n    N = len(gx)\n    if N > 0:\n        T = (time[-1] - time[0]) / N if len(time) > 1 else 1/ConfigBaseline.FS\n        yf = fft(gx)\n        xf = fftfreq(N, T)[:N//2]\n        power = np.abs(yf[:N//2])\n        if len(power) > 1:\n            freq_dominante = xf[np.argmax(power[1:]) + 1]\n        else:\n            freq_dominante = 0\n    else:\n        freq_dominante = 0\n    \n    # 5. Calidad del movimiento (variabilidad)\n    regularidad = 0\n    if amplitudes and np.mean(amplitudes) > 0:\n        cv = np.std(amplitudes) / np.mean(amplitudes)\n        regularidad = (1 - cv) * 100\n        regularidad = max(0, min(100, regularidad))\n    \n    # 6. Compensación lateral (ay) durante movimiento\n    compensacion_ay = 0\n    if len(ay) > 0:\n        compensacion_ay = np.std(ay)\n    \n    # 7. Eje principal de movimiento\n    rango_x = np.ptp(gx) if len(gx) > 0 else 0\n    rango_y = np.ptp(gy) if len(gy) > 0 else 0\n    rango_z = np.ptp(gz) if len(gz) > 0 else 0\n    \n    ejes = {'ωx': rango_x, 'ωy': rango_y, 'ωz': rango_z}\n    eje_principal = max(ejes, key=ejes.get) if ejes else 'ωx'\n    \n    # 8. Cadencia (ciclos por segundo)\n    cadencia = 0\n    if n_ciclos > 1 and len(tiempos_ciclo) > 1:\n        intervalo_medio = np.mean(np.diff(tiempos_ciclo))\n        if intervalo_medio > 0:\n            cadencia = 1.0 / intervalo_medio\n\n    # MÉTRICAS NIVEL 2\n    # 1️⃣ JERK RMS (suavidad del movimiento)\n    jerk_x = np.gradient(ax, dt)\n    jerk_rms = np.sqrt(np.mean(jerk_x ** 2)) if len(jerk_x) > 0 else 0.0\n\n    # 2️⃣ RMS de aceleración lateral (compensaciones)\n    rms_acc_lateral = np.sqrt(np.mean(ay**2 + az**2)) if len(ay) > 0 else 0.0\n\n    # 3️⃣ Relación de energía entre ejes (giroscopio)\n    energia_x = np.mean(gx**2)\n    energia_y = np.mean(gy**2)\n    energia_z = np.mean(gz**2)\n\n    energia_total = energia_x + energia_y + energia_z\n    energia_relativa_x = energia_x / energia_total if energia_total > 0 else 0.0\n\n    # CONVERTIR TODOS LOS VALORES NUMPY A TIPOS NATIVOS DE PYTHON\n    return {\n        # Identificación\n        'device_id': procesado['device_id'],\n        'n_ciclos': int(n_ciclos),\n        'duracion': float(time[-1] - time[0]) if len(time) > 1 else 0.0,\n        \n        # Amplitud\n        'amplitud_media': float(np.mean(amplitudes)) if amplitudes else 0.0,\n        'amplitud_std': float(np.std(amplitudes)) if amplitudes else 0.0,\n        'amplitud_cv': float(np.std(amplitudes)/np.mean(amplitudes)) if amplitudes and np.mean(amplitudes) > 0 else 0.0,\n        'amplitud_max': float(np.max(amplitudes)) if amplitudes else 0.0,\n        'amplitud_min': float(np.min(amplitudes)) if amplitudes else 0.0,\n        \n        # Velocidad\n        'velocidad_pico_media': float(np.mean(velocidades_pico)) if velocidades_pico else 0.0,\n        'velocidad_pico_max': float(np.max(velocidades_pico)) if velocidades_pico else 0.0,\n        'velocidad_pico_std': float(np.std(velocidades_pico)) if velocidades_pico else 0.0,\n        \n        # Frecuencia y ritmo\n        'frecuencia': float(freq_dominante),\n        'cadencia': float(cadencia),\n        'intervalo_medio': float(np.mean(np.diff(tiempos_ciclo))) if len(tiempos_ciclo) > 1 else 0.0,\n        \n        # Calidad\n        'regularidad': float(regularidad),\n        'compensacion_lateral': float(compensacion_ay),\n        \n        # Ejes\n        'eje_principal': str(eje_principal),\n        'rango_ωx': float(rango_x),\n        'rango_ωy': float(rango_y),\n        'rango_ωz': float(rango_z),\n        \n        # Datos para graficación\n        'picos_pos': picos_pos.tolist() if hasattr(picos_pos, 'tolist') else list(picos_pos),\n        'picos_neg': picos_neg.tolist() if hasattr(picos_neg, 'tolist') else list(picos_neg),\n\n        # NIVEL 2\n        'jerk_rms': float(jerk_rms),\n        'rms_acc_lateral': float(rms_acc_lateral),\n        'energia_relativa_x': float(energia_relativa_x),\n        \n        # Validación\n        'valido': bool(n_ciclos >= ConfigBaseline.CICLOS_MIN_VALIDOS and \n                      (time[-1] - time[0]) >= ConfigBaseline.DURACION_MINIMA)\n    }\n\n# ========================================\n# 6. VISUALIZACIÓN COMPLETA\n# ========================================\ndef graficar_señales_completas(procesado, variables, output_path, sujeto_id):\n    \"\"\"\n    Genera gráficas COMPLETAS con visualización detallada de la detección\n    \"\"\"\n    fig = plt.figure(figsize=(24, 18))\n    \n    # 1. GIROSCOPIO ωx con DETECCIÓN DETALLADA (ocupa 2 columnas)\n    ax1 = plt.subplot(5, 4, (1, 2))\n    ax1.plot(procesado['time'], procesado['gx'], 'b-', linewidth=1.5, alpha=0.7, label='ωx filtrada')\n    ax1.plot(procesado['time'], procesado['gx_raw'], 'b--', linewidth=0.8, alpha=0.3, label='ωx cruda')\n    \n    # Marcar picos detectados\n    if len(variables['picos_pos']) > 0:\n        ax1.plot(procesado['time'][variables['picos_pos']], \n                 procesado['gx'][variables['picos_pos']], \n                 'ro', markersize=8, markeredgecolor='black', linewidth=1,\n                 label=f'Pronación ({len(variables[\"picos_pos\"])})')\n    \n    if len(variables['picos_neg']) > 0:\n        ax1.plot(procesado['time'][variables['picos_neg']], \n                 procesado['gx'][variables['picos_neg']], \n                 'go', markersize=8, markeredgecolor='black', linewidth=1,\n                 label=f'Supinación ({len(variables[\"picos_neg\"])})')\n    \n    # Líneas de umbral\n    altura_min_pos = np.max(procesado['gx']) * ConfigBaseline.PICO_HEIGHT_FACTOR_POS\n    altura_min_neg = np.min(procesado['gx']) * ConfigBaseline.PICO_HEIGHT_FACTOR_NEG\n    \n    ax1.axhline(altura_min_pos, color='red', linestyle=':', alpha=0.5, label='Umbral pronación')\n    ax1.axhline(altura_min_neg, color='green', linestyle=':', alpha=0.5, label='Umbral supinación')\n    \n    ax1.set_xlabel('Tiempo [s]', fontsize=10)\n    ax1.set_ylabel('ωx [°/s]', fontsize=10, fontweight='bold')\n    ax1.set_title(f'GIROSCOPIO ωx - {variables[\"n_ciclos\"]} ciclos detectados', \n                  fontsize=12, fontweight='bold')\n    ax1.grid(True, alpha=0.3)\n    ax1.legend(loc='upper right', fontsize=8)\n    ax1.axhline(0, color='black', linestyle='--', alpha=0.3)\n    \n    # 2. ACELERÓMETRO ay (Compensación lateral) (ocupa 2 columnas)\n    ax2 = plt.subplot(5, 4, (3, 4))\n    ax2.plot(procesado['time'], procesado['ay'], 'g-', linewidth=1.5, alpha=0.8, label='ay filtrada')\n    ax2.plot(procesado['time'], procesado['ay_raw'], 'g--', linewidth=0.8, alpha=0.3, label='ay cruda')\n    \n    if len(variables['picos_pos']) > 0:\n        ax2.plot(procesado['time'][variables['picos_pos']], \n                 procesado['ay'][variables['picos_pos']], \n                 'r.', markersize=6, label='Picos pronación')\n    \n    if len(variables['picos_neg']) > 0:\n        ax2.plot(procesado['time'][variables['picos_neg']], \n                 procesado['ay'][variables['picos_neg']], \n                 'g.', markersize=6, label='Picos supinación')\n    \n    ax2.set_xlabel('Tiempo [s]', fontsize=10)\n    ax2.set_ylabel('ay [g]', fontsize=10, fontweight='bold')\n    ax2.set_title('ACELERÓMETRO ay (Compensación lateral)', fontsize=12, fontweight='bold')\n    ax2.grid(True, alpha=0.3)\n    ax2.legend(loc='upper right', fontsize=8)\n    ax2.axhline(0, color='black', linestyle='--', alpha=0.3)\n    \n    # 3. GIROSCOPIO ωy\n    ax3 = plt.subplot(5, 4, 5)\n    ax3.plot(procesado['time'], procesado['gy'], 'g-', linewidth=1.5)\n    ax3.set_xlabel('Tiempo [s]', fontsize=9)\n    ax3.set_ylabel('ωy [°/s]', fontsize=9, fontweight='bold')\n    ax3.set_title('GIROSCOPIO: ωy', fontsize=10, fontweight='bold')\n    ax3.grid(True, alpha=0.3)\n    ax3.axhline(0, color='red', linestyle='--', alpha=0.3)\n    \n    # 4. GIROSCOPIO ωz\n    ax4 = plt.subplot(5, 4, 6)\n    ax4.plot(procesado['time'], procesado['gz'], 'r-', linewidth=1.5)\n    ax4.set_xlabel('Tiempo [s]', fontsize=9)\n    ax4.set_ylabel('ωz [°/s]', fontsize=9, fontweight='bold')\n    ax4.set_title('GIROSCOPIO: ωz', fontsize=10, fontweight='bold')\n    ax4.grid(True, alpha=0.3)\n    ax4.axhline(0, color='red', linestyle='--', alpha=0.3)\n    \n    # 5. FFT de ωx\n    ax5 = plt.subplot(5, 4, 7)\n    if len(procesado['gx']) > 0:\n        N = len(procesado['gx'])\n        T = (procesado['time'][-1] - procesado['time'][0]) / N if len(procesado['time']) > 1 else 1/ConfigBaseline.FS\n        yf = fft(procesado['gx'])\n        xf = fftfreq(N, T)[:N//2]\n        \n        ax5.plot(xf[1:], np.abs(yf[:N//2])[1:], 'b-', linewidth=1.5)\n        \n        if variables['frecuencia'] > 0:\n            ax5.axvline(variables['frecuencia'], color='red', linestyle='--', \n                       alpha=0.7, label=f'Freq: {variables[\"frecuencia\"]:.2f} Hz')\n        \n        ax5.set_xlabel('Frecuencia [Hz]', fontsize=9)\n        ax5.set_ylabel('Magnitud', fontsize=9)\n        ax5.set_title('ESPECTRO: ωx', fontsize=10, fontweight='bold')\n        ax5.grid(True, alpha=0.3)\n        ax5.set_xlim([0, 5])\n        ax5.legend(loc='upper right', fontsize=8)\n    \n    # 6. Histograma de amplitudes\n    ax6 = plt.subplot(5, 4, 8)\n    if variables['n_ciclos'] > 0:\n        amplitudes = []\n        for i in range(variables['n_ciclos']):\n            if i < len(variables['picos_pos']) and i < len(variables['picos_neg']):\n                amp = abs(procesado['gx'][variables['picos_pos'][i]] - \n                         procesado['gx'][variables['picos_neg'][i]])\n                amplitudes.append(amp)\n        \n        if amplitudes:\n            ax6.hist(amplitudes, bins=min(10, len(amplitudes)), \n                     alpha=0.7, color='skyblue', edgecolor='black')\n            ax6.axvline(np.mean(amplitudes), color='red', linestyle='--', \n                        linewidth=2, label=f'Media: {np.mean(amplitudes):.1f}°/s')\n            ax6.set_xlabel('Amplitud [°/s]', fontsize=9)\n            ax6.set_ylabel('Frecuencia', fontsize=9)\n            ax6.set_title('DISTRIBUCIÓN AMPLITUDES', fontsize=10, fontweight='bold')\n            ax6.grid(True, alpha=0.3, axis='y')\n            ax6.legend(loc='upper right', fontsize=8)\n    \n    # 7. ACELERÓMETRO ax\n    ax7 = plt.subplot(5, 4, 9)\n    ax7.plot(procesado['time'], procesado['ax'], 'b-', linewidth=1.5, alpha=0.8)\n    ax7.plot(procesado['time'], procesado['ax_raw'], 'b--', linewidth=0.8, alpha=0.3)\n    ax7.set_xlabel('Tiempo [s]', fontsize=9)\n    ax7.set_ylabel('ax [g]', fontsize=9, fontweight='bold')\n    ax7.set_title('ACELERÓMETRO: ax', fontsize=10, fontweight='bold')\n    ax7.grid(True, alpha=0.3)\n    ax7.axhline(0, color='red', linestyle='--', alpha=0.3)\n    \n    # 8. ACELERÓMETRO az\n    ax8 = plt.subplot(5, 4, 10)\n    ax8.plot(procesado['time'], procesado['az'], 'r-', linewidth=1.5, alpha=0.8)\n    ax8.plot(procesado['time'], procesado['az_raw'], 'r--', linewidth=0.8, alpha=0.3)\n    ax8.set_xlabel('Tiempo [s]', fontsize=9)\n    ax8.set_ylabel('az [g]', fontsize=9, fontweight='bold')\n    ax8.set_title('ACELERÓMETRO: az', fontsize=10, fontweight='bold')\n    ax8.grid(True, alpha=0.3)\n    ax8.axhline(0, color='red', linestyle='--', alpha=0.3)\n    \n    # 9. Magnitud de aceleración\n    ax9 = plt.subplot(5, 4, 11)\n    magnitud = np.sqrt(procesado['ax']**2 + procesado['ay']**2 + procesado['az']**2)\n    magnitud_raw = np.sqrt(procesado['ax_raw']**2 + procesado['ay_raw']**2 + procesado['az_raw']**2)\n    \n    ax9.plot(procesado['time'], magnitud, 'purple', linewidth=1.5, alpha=0.8, label='Filtrada')\n    ax9.plot(procesado['time'], magnitud_raw, 'purple', linewidth=0.8, alpha=0.3, label='Cruda')\n    ax9.axhline(1.0, color='red', linestyle='--', alpha=0.5, label='1g ref')\n    ax9.set_xlabel('Tiempo [s]', fontsize=9)\n    ax9.set_ylabel('|a| [g]', fontsize=9, fontweight='bold')\n    ax9.set_title('MAGNITUD ACELERACIÓN', fontsize=10, fontweight='bold')\n    ax9.grid(True, alpha=0.3)\n    ax9.legend(loc='upper right', fontsize=8)\n    \n    # 10. Jerk\n    ax10 = plt.subplot(5, 4, 12)\n    dt = np.mean(np.diff(procesado['time'])) if len(procesado['time']) > 1 else 1/ConfigBaseline.FS\n    jerk = np.gradient(procesado['ax'], dt)\n    ax10.plot(procesado['time'], jerk, 'm-', linewidth=1.3)\n    ax10.set_title(f'JERK (RMS={variables[\"jerk_rms\"]:.3f})', fontsize=10, fontweight='bold')\n    ax10.set_xlabel('Tiempo [s]', fontsize=9)\n    ax10.set_ylabel('Jerk [g/s]', fontsize=9)\n    ax10.grid(True, alpha=0.3)\n    \n    # 11. Evolución temporal de amplitudes\n    ax11 = plt.subplot(5, 4, 13)\n    if variables['n_ciclos'] > 0:\n        amplitudes_evo = []\n        tiempos_evo = []\n        \n        for i in range(variables['n_ciclos']):\n            if i < len(variables['picos_pos']) and i < len(variables['picos_neg']):\n                pos_idx = variables['picos_pos'][i]\n                neg_idx = variables['picos_neg'][i]\n                amp = abs(procesado['gx'][pos_idx] - procesado['gx'][neg_idx])\n                amplitudes_evo.append(amp)\n                tiempos_evo.append(procesado['time'][pos_idx])\n        \n        if amplitudes_evo:\n            ax11.plot(tiempos_evo, amplitudes_evo, 'bo-', linewidth=1.5, markersize=5)\n            \n            if len(amplitudes_evo) > 2:\n                z = np.polyfit(tiempos_evo, amplitudes_evo, 1)\n                p = np.poly1d(z)\n                ax11.plot(tiempos_evo, p(tiempos_evo), 'r--', alpha=0.7, \n                         label=f'Tendencia: {z[0]:.2f}°/s²')\n            \n            ax11.set_xlabel('Tiempo [s]', fontsize=9)\n            ax11.set_ylabel('Amplitud [°/s]', fontsize=9)\n            ax11.set_title('EVOLUCIÓN AMPLITUDES', fontsize=10, fontweight='bold')\n            ax11.grid(True, alpha=0.3)\n            if len(amplitudes_evo) > 2:\n                ax11.legend(loc='best', fontsize=8)\n    \n    # 12. Velocidades pico\n    ax12 = plt.subplot(5, 4, 14)\n    if variables['n_ciclos'] > 0:\n        velocidades_pos = []\n        velocidades_neg = []\n        tiempos_vel = []\n        \n        for i in range(variables['n_ciclos']):\n            if i < len(variables['picos_pos']) and i < len(variables['picos_neg']):\n                velocidades_pos.append(abs(procesado['gx'][variables['picos_pos'][i]]))\n                velocidades_neg.append(abs(procesado['gx'][variables['picos_neg'][i]]))\n                tiempos_vel.append(procesado['time'][variables['picos_pos'][i]])\n        \n        if velocidades_pos:\n            ax12.plot(tiempos_vel, velocidades_pos, 'ro-', linewidth=1.5, \n                     markersize=4, label='Pronación')\n            ax12.plot(tiempos_vel, velocidades_neg, 'go-', linewidth=1.5, \n                     markersize=4, label='Supinación')\n            ax12.set_xlabel('Tiempo [s]', fontsize=9)\n            ax12.set_ylabel('Velocidad [°/s]', fontsize=9)\n            ax12.set_title('VELOCIDADES PICO', fontsize=10, fontweight='bold')\n            ax12.grid(True, alpha=0.3)\n            ax12.legend(loc='best', fontsize=8)\n    \n    # 13. Relación ωx vs ay\n    ax13 = plt.subplot(5, 4, 15)\n    if len(procesado['gx']) > 0 and len(procesado['ay']) > 0:\n        scatter = ax13.scatter(procesado['gx'], procesado['ay'], \n                             c=procesado['time'], cmap='viridis', \n                             alpha=0.6, s=10)\n        ax13.set_xlabel('ωx [°/s]', fontsize=9)\n        ax13.set_ylabel('ay [g]', fontsize=9)\n        ax13.set_title('RELACIÓN: Rotación vs Compensación', fontsize=10, fontweight='bold')\n        ax13.grid(True, alpha=0.3)\n        ax13.axhline(0, color='red', linestyle='--', alpha=0.3)\n        ax13.axvline(0, color='red', linestyle='--', alpha=0.3)\n        plt.colorbar(scatter, ax=ax13, label='Tiempo [s]')\n    \n    # 14. Aceleración lateral\n    ax14 = plt.subplot(5, 4, 16)\n    ax14.plot(procesado['time'], procesado['ay'], label='ay', alpha=0.7)\n    ax14.plot(procesado['time'], procesado['az'], label='az', alpha=0.7)\n    ax14.set_title(\n        f'ACC LATERAL RMS={variables[\"rms_acc_lateral\"]:.3f}g',\n        fontsize=10, fontweight='bold'\n    )\n    ax14.set_xlabel('Tiempo [s]', fontsize=9)\n    ax14.set_ylabel('g', fontsize=9)\n    ax14.legend(fontsize=8)\n    ax14.grid(True, alpha=0.3)\n    \n    # 15. Tabla de métricas (ocupa últimas 4 posiciones)\n    ax15 = plt.subplot(5, 4, (17, 20))\n    ax15.axis('tight')\n    ax15.axis('off')\n    \n    asimetria_amp = \"N/A\"\n    if variables['n_ciclos'] > 0 and 'amplitud_media' in variables:\n        asimetria_amp = f\"{variables['amplitud_cv']*100:.1f}%\"\n    \n    tabla_datos = [\n        ['MÉTRICA', 'VALOR', 'INTERPRETACIÓN'],\n        ['Ciclos totales', f\"{variables['n_ciclos']}\", f\"Mín {ConfigBaseline.CICLOS_MIN_VALIDOS}\"],\n        ['Duración [s]', f\"{variables['duracion']:.1f}\", f\"Mín {ConfigBaseline.DURACION_MINIMA}s\"],\n        ['Amplitud media', f\"{variables['amplitud_media']:.1f} °/s\", f\"±{variables['amplitud_std']:.1f}\"],\n        ['Variabilidad', f\"{variables['amplitud_cv']:.3f}\", f\"{asimetria_amp}\"],\n        ['Velocidad pico', f\"{variables['velocidad_pico_media']:.1f} °/s\", f\"Max {variables['velocidad_pico_max']:.1f}\"],\n        ['Frecuencia', f\"{variables['frecuencia']:.2f} Hz\", f\"Cadencia {variables['cadencia']:.2f} Hz\"],\n        ['Regularidad', f\"{variables['regularidad']:.1f}%\", \"100% = perfecta\"],\n        ['Compensación', f\"{variables['compensacion_lateral']:.3f} g\", \"Variabilidad ay\"],\n        ['Eje principal', variables['eje_principal'], f\"ωx={variables['rango_ωx']:.0f}°/s\"],\n        ['Jerk RMS', f'{variables[\"jerk_rms\"]:.3f}', 'Suavidad del movimiento'],\n        ['RMS acc lateral', f'{variables[\"rms_acc_lateral\"]:.3f} g', 'Compensación'],\n        ['Energía eje principal', f'{variables[\"energia_relativa_x\"]:.2f}', 'Control eje ωx'],\n        ['Estado', 'VÁLIDO' if variables['valido'] else 'INSUFICIENTE', \n         '✓' if variables['valido'] else '✗ Revisar']\n    ]\n    \n    tabla = ax15.table(cellText=tabla_datos, loc='center', cellLoc='left')\n    tabla.auto_set_font_size(False)\n    tabla.set_fontsize(8)\n    tabla.scale(1.0, 2.0)\n    \n    # Color según validez\n    for i in range(len(tabla_datos)):\n        for j in range(3):\n            cell = tabla[(i, j)]\n            cell.set_edgecolor('gray')\n            \n            if i == 0:  # Encabezado\n                cell.set_facecolor('#2c3e50')\n                cell.set_text_props(weight='bold', color='white', fontsize=9)\n            elif i == len(tabla_datos)-1:  # Última fila\n                if variables['valido']:\n                    cell.set_facecolor('#d4edda')\n                    cell.set_text_props(weight='bold', color='#155724')\n                else:\n                    cell.set_facecolor('#f8d7da')\n                    cell.set_text_props(weight='bold', color='#721c24')\n            elif i == 1:  # Ciclos totales\n                if variables['n_ciclos'] >= 10:\n                    cell.set_facecolor('#d4edda')\n                elif variables['n_ciclos'] >= 5:\n                    cell.set_facecolor('#fff3cd')\n                else:\n                    cell.set_facecolor('#f8d7da')\n    \n    plt.suptitle(f'ANÁLISIS BASELINE DETALLADO - {procesado[\"device_id\"]} | Sujeto: {sujeto_id}', \n                 fontsize=14, fontweight='bold', y=0.995)\n    plt.tight_layout()\n    \n    # Guardar\n    os.makedirs(os.path.dirname(output_path), exist_ok=True)\n    plt.savefig(output_path, dpi=150, bbox_inches='tight')\n    plt.close()\n    \n    print(f\"   ✓ Gráfica detallada guardada: {os.path.basename(output_path)}\")\n    return output_path\n\n# ========================================\n# 7. FUNCIÓN PRINCIPAL\n# ========================================\ndef analisis_baseline_pronacion(archivo_path, debug=False):\n    \"\"\"\n    Función principal para análisis baseline con opción de debug\n    \"\"\"\n    print(\"\\n\" + \"=\"*80)\n    print(\"ANÁLISIS BASELINE COMPLETO: PRONACIÓN-SUPINACIÓN\")\n    print(\"=\"*80)\n    \n    config = ConfigBaseline\n    \n    # Crear carpetas de salida\n    os.makedirs(config.OUTPUT_BASE, exist_ok=True)\n    os.makedirs(config.OUTPUT_INDIVIDUAL, exist_ok=True)\n    os.makedirs(config.OUTPUT_SUMMARY, exist_ok=True)\n    \n    # 1. Cargar datos\n    print(f\"\\n📁 CARGANDO ARCHIVO: {os.path.basename(archivo_path)}\")\n    try:\n        with open(archivo_path, \"r\") as f:\n            data = json.load(f)\n        imu_data = data.get(\"imuData\", [])\n        print(f\"   ✓ Muestras totales: {len(imu_data)}\")\n    except Exception as e:\n        print(f\"   ✗ ERROR al cargar archivo: {e}\")\n        return None\n    \n    # 2. Detectar tipo de prueba\n    tipo_prueba, descripcion, dispositivos = detectar_tipo_prueba(archivo_path, imu_data)\n    print(f\"\\n🔍 DETECCIÓN DE PRUEBA:\")\n    print(f\"   • Tipo: {descripcion}\")\n    print(f\"   • Dispositivos encontrados: {', '.join(dispositivos) if dispositivos else 'Ninguno'}\")\n    \n    # 3. Separar datos por dispositivo\n    datos_por_dispositivo = separar_por_dispositivo(imu_data)\n    if not datos_por_dispositivo:\n        print(\"   ✗ No se encontraron datos válidos\")\n        return None\n    \n    print(f\"\\n📊 PROCESANDO {len(datos_por_dispositivo)} DISPOSITIVO(S):\")\n    \n    resultados = {}\n    variables_totales = {}\n    \n    for device_id, datos in datos_por_dispositivo.items():\n        print(f\"\\n   • {device_id}: {len(datos)} muestras\")\n        \n        # 4. Procesar dispositivo\n        procesado = procesar_dispositivo_baseline(datos, device_id, config)\n        \n        # 5. Analizar variables\n        variables = analizar_variables_baseline(procesado, debug=debug)\n        \n        # 6. Graficar\n        sujeto_id = os.path.splitext(os.path.basename(archivo_path))[0]\n        grafico_path = os.path.join(\n            config.OUTPUT_INDIVIDUAL, \n            f\"{sujeto_id}_{device_id}_baseline_DETALLADO.png\"\n        )\n        grafico_guardado = graficar_señales_completas(\n            procesado, variables, grafico_path, sujeto_id\n        )\n        \n        # Guardar resultados\n        resultados[device_id] = {\n            'procesado': procesado,\n            'variables': variables,\n            'grafico': grafico_guardado\n        }\n        variables_totales[device_id] = variables\n        \n        print(f\"     ✓ Ciclos detectados: {variables['n_ciclos']}\")\n        print(f\"     ✓ Amplitud media: {variables['amplitud_media']:.1f} °/s\")\n        print(f\"     ✓ Velocidad pico: {variables['velocidad_pico_media']:.1f} °/s\")\n        print(f\"     ✓ Regularidad: {variables['regularidad']:.1f}%\")\n        print(f\"     ✓ Estado: {'VÁLIDO' if variables['valido'] else 'INSUFICIENTE'}\")\n    \n    # 7. Generar reporte\n    if variables_totales:\n        reporte_path = os.path.join(\n            config.OUTPUT_BASE, \"reportes\",\n            f\"baseline_{os.path.basename(archivo_path)}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt\"\n        )\n        \n        os.makedirs(os.path.dirname(reporte_path), exist_ok=True)\n        \n        with open(reporte_path, 'w', encoding='utf-8') as f:\n            f.write(\"=\"*80 + \"\\n\")\n            f.write(\"REPORTE DE BASELINE DETALLADO\\n\")\n            f.write(\"=\"*80 + \"\\n\\n\")\n            \n            f.write(f\"Archivo: {os.path.basename(archivo_path)}\\n\")\n            f.write(f\"Tipo de prueba: {descripcion}\\n\")\n            f.write(f\"Fecha análisis: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\\n\")\n            f.write(f\"Dispositivos: {len(variables_totales)}\\n\\n\")\n            \n            for device_id, vars_dict in variables_totales.items():\n                f.write(f\"{'='*40}\\n\")\n                f.write(f\"DISPOSITIVO: {device_id}\\n\")\n                f.write(f\"{'='*40}\\n\\n\")\n                \n                f.write(f\"Ciclos detectados: {vars_dict['n_ciclos']}\\n\")\n                f.write(f\"Duración: {vars_dict['duracion']:.1f} s\\n\")\n                f.write(f\"Amplitud media: {vars_dict['amplitud_media']:.1f} °/s\\n\")\n                f.write(f\"Amplitud std: {vars_dict['amplitud_std']:.1f} °/s\\n\")\n                f.write(f\"Amplitud CV: {vars_dict['amplitud_cv']:.3f}\\n\")\n                f.write(f\"Velocidad pico media: {vars_dict['velocidad_pico_media']:.1f} °/s\\n\")\n                f.write(f\"Frecuencia: {vars_dict['frecuencia']:.2f} Hz\\n\")\n                f.write(f\"Cadencia: {vars_dict['cadencia']:.2f} Hz\\n\")\n                f.write(f\"Regularidad: {vars_dict['regularidad']:.1f}%\\n\")\n                f.write(f\"Compensación lateral: {vars_dict['compensacion_lateral']:.3f} g\\n\")\n                f.write(f\"Eje principal: {vars_dict['eje_principal']}\\n\")\n                f.write(f\"Estado: {'VÁLIDO' if vars_dict['valido'] else 'INSUFICIENTE'}\\n\\n\")\n        \n        print(f\"\\n💾 REPORTE guardado: {os.path.basename(reporte_path)}\")\n        \n        # 8. Guardar variables en JSON\n        json_path = os.path.join(\n            config.OUTPUT_SUMMARY, \n            f\"{sujeto_id}_variables.json\"\n        )\n        \n        # Convertir a serializable\n        variables_serializables = {}\n        for device_id, vars_dict in variables_totales.items():\n            vars_serializable = {}\n            for key, value in vars_dict.items():\n                if isinstance(value, (np.integer, np.int64, np.int32)):\n                    vars_serializable[key] = int(value)\n                elif isinstance(value, (np.floating, np.float64, np.float32)):\n                    vars_serializable[key] = float(value)\n                elif isinstance(value, (np.bool_, bool)):\n                    vars_serializable[key] = bool(value)\n                elif isinstance(value, np.ndarray):\n                    vars_serializable[key] = value.tolist()\n                else:\n                    vars_serializable[key] = value\n            variables_serializables[device_id] = vars_serializable\n        \n        with open(json_path, 'w', encoding='utf-8') as f:\n            json.dump({\n                'archivo': os.path.basename(archivo_path),\n                'tipo_prueba': tipo_prueba,\n                'fecha_analisis': datetime.now().isoformat(),\n                'variables': variables_serializables\n            }, f, indent=2, ensure_ascii=False)\n        \n        print(f\"💾 JSON variables guardado: {os.path.basename(json_path)}\")\n    \n    print(\"\\n\" + \"=\"*80)\n    print(\"ANÁLISIS BASELINE COMPLETADO\")\n    print(\"=\"*80)\n    \n    return {\n        'archivo': archivo_path,\n        'tipo_prueba': tipo_prueba,\n        'dispositivos': list(datos_por_dispositivo.keys()),\n        'resultados': resultados,\n        'variables_totales': variables_totales\n    }\n\n# ========================================\n# 8. PROCESAMIENTO DE ARCHIVO O CARPETA\n# ========================================\ndef procesar_entrada(path_entrada, debug=False):\n    \"\"\"\n    Permite procesar un archivo JSON individual o una carpeta completa\n    \"\"\"\n    resultados_globales = []\n\n    if os.path.isfile(path_entrada):\n        print(\"\\n📄 MODO: ARCHIVO ÚNICO\")\n        resultado = analisis_baseline_pronacion(path_entrada, debug=debug)\n        if resultado:\n            resultados_globales.append(resultado)\n\n    elif os.path.isdir(path_entrada):\n        print(\"\\n📁 MODO: CARPETA COMPLETA\")\n\n        archivos = sorted([\n            os.path.join(path_entrada, f)\n            for f in os.listdir(path_entrada)\n            if f.lower().endswith(\".json\")\n        ])\n\n        print(f\"   • Archivos encontrados: {len(archivos)}\")\n\n        if not archivos:\n            print(\"   ⚠️  No se encontraron archivos JSON\")\n            return []\n\n        for i, archivo in enumerate(archivos, 1):\n            print(f\"\\n▶ Procesando [{i}/{len(archivos)}]: {os.path.basename(archivo)}\")\n            try:\n                resultado = analisis_baseline_pronacion(archivo, debug=debug)\n                if resultado:\n                    resultados_globales.append(resultado)\n            except Exception as e:\n                print(f\"   ✗ Error procesando {archivo}: {e}\")\n\n    else:\n        print(f\"\\n❌ Ruta inválida: {path_entrada}\")\n\n    return resultados_globales\n\n# ========================================\n# 9. GENERACIÓN DE EXCEL BASELINE\n# ========================================\ndef generar_excel_baseline(resultados, output_dir):\n    \"\"\"\n    Genera un Excel con métricas y resumen estadístico baseline\n    \"\"\"\n    filas = []\n\n    for r in resultados:\n        archivo = os.path.basename(r['archivo'])\n        tipo_prueba = r['tipo_prueba']\n\n        for device_id, vars_dict in r['variables_totales'].items():\n            fila = {\n                'archivo': archivo,\n                'dispositivo': device_id,\n                'tipo_prueba': tipo_prueba,\n                'valido': vars_dict['valido']\n            }\n\n            # Solo métricas numéricas\n            for k, v in vars_dict.items():\n                if isinstance(v, (int, float)):\n                    fila[k] = v\n\n            filas.append(fila)\n\n    df_raw = pd.DataFrame(filas)\n\n    # BASELINE (solo válidos)\n    df_validos = df_raw[df_raw['valido'] == True]\n\n    if len(df_validos) > 0:\n        df_summary = df_validos.describe().T\n        df_summary['cv'] = df_summary['std'] / df_summary['mean']\n    else:\n        df_summary = pd.DataFrame()\n\n    # GUARDAR EXCEL\n    os.makedirs(output_dir, exist_ok=True)\n\n    excel_path = os.path.join(\n        output_dir,\n        f\"baseline_pronacion_supinacion_{datetime.now().strftime('%Y%m%d_%H%M%S')}.xlsx\"\n    )\n\n    with pd.ExcelWriter(excel_path, engine='xlsxwriter') as writer:\n        df_raw.to_excel(writer, sheet_name='raw_metrics', index=False)\n        if len(df_summary) > 0:\n            df_summary.to_excel(writer, sheet_name='baseline_summary')\n\n    print(f\"\\n📊 EXCEL BASELINE GENERADO:\")\n    print(f\"   ✓ {excel_path}\")\n\n    return excel_path\n\n\nif __name__ == \"__main__\":\n    \"\"\"\n    Punto de entrada - Archivo único o carpeta completa\n    \"\"\"\n\n    # RUTA DE ENTRADA (archivo o carpeta)\n    RUTA_ENTRADA = \"/work/Prueba\"\n\n    # AJUSTE DE PARÁMETROS DE DETECCIÓN\n    ConfigBaseline.PICO_HEIGHT_FACTOR_POS = 0.10\n    ConfigBaseline.PICO_HEIGHT_FACTOR_NEG = 0.10\n    ConfigBaseline.PICO_PROMINENCE_FACTOR = 0.10\n    ConfigBaseline.PICO_MIN_DISTANCE = 10\n\n    MODO_DEBUG = True\n\n    print(\"\\n⚙️  CONFIGURACIÓN ACTIVA:\")\n    print(f\"   • Ruta entrada: {RUTA_ENTRADA}\")\n    print(f\"   • Debug: {'ON' if MODO_DEBUG else 'OFF'}\")\n    print(f\"   • Umbral picos: {ConfigBaseline.PICO_HEIGHT_FACTOR_POS*100:.0f}%\")\n    print(f\"   • Prominencia: {ConfigBaseline.PICO_PROMINENCE_FACTOR*100:.0f}%\")\n\n    resultados = procesar_entrada(RUTA_ENTRADA, debug=MODO_DEBUG)\n\n    # RESUMEN GLOBAL\n    if resultados:\n        print(\"\\n\" + \"=\"*80)\n        print(\"RESUMEN GLOBAL DEL ANÁLISIS\")\n        print(\"=\"*80)\n        print(f\"Pruebas procesadas: {len(resultados)}\")\n\n        total_validos = 0\n        total_dispositivos = 0\n\n        for r in resultados:\n            for vars_dict in r['variables_totales'].values():\n                total_dispositivos += 1\n                if vars_dict['valido']:\n                    total_validos += 1\n\n        print(f\"Dispositivos analizados: {total_dispositivos}\")\n        print(f\"Pruebas válidas: {total_validos}\")\n        print(f\"Pruebas inválidas: {total_dispositivos - total_validos}\")\n\n        print(\"\\n📁 SALIDAS GENERADAS:\")\n        print(f\"   • Gráficas: {ConfigBaseline.OUTPUT_INDIVIDUAL}/\")\n        print(f\"   • JSON resumen: {ConfigBaseline.OUTPUT_SUMMARY}/\")\n        print(f\"   • Reportes: {ConfigBaseline.OUTPUT_BASE}/reportes/\")\n\n        # EXPORTAR EXCEL BASELINE\n        excel_path = generar_excel_baseline(\n            resultados,\n            ConfigBaseline.OUTPUT_BASE\n        )",
    "execution_context_id": "082437ff-768f-4868-aaab-aa060f387b36",
