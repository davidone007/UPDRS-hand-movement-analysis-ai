   "source": [
    "\"\"\"\n",
    "============================================================================\n",
    "ANÁLISIS BASELINE COMPLETO: PRONACIÓN-SUPINACIÓN CON DETECCIÓN MEJORADA\n",
    "============================================================================\n",
    "CORRECCIONES APLICADAS v2:\n",
    "  1.  Remuestreo uniforme\n",
    "  2.  Emparejamiento greedy bidireccional (sin doble conteo)\n",
    "  3.  Estimación de ángulo (integración trapezoidal de ωx)\n",
    "  4.  Jerk angular + jerk lineal del eje dominante (no hardcodeado)\n",
    "  5.  FFT usa T=1/FS correcto\n",
    "  6.  GYRO_LOWCUT = 0.1 Hz\n",
    "  7.  Validación FS real vs asumida\n",
    "  8.  Alternancia conserva mayor amplitud absoluta\n",
    "  9.  [FIX] Top-N se aplica DESPUÉS de alternancia (no antes)\n",
    "  10. [FIX] Estrategia 2 rescata SOLO el tipo deficiente (no recalcula ambos)\n",
    "  11. [FIX] altura_min_neg usa np.abs() → robusto si señal toda positiva\n",
    "  12. [FIX] Cadencia e intervalo_medio desde picos_pos reales (no tiempos_medio)\n",
    "  13. [FIX] energia_relativa y jerk_lineal usan eje dominante real (max varianza)\n",
    "  14. [FIX] compensacion_lateral: std de ejes gyro NO dominantes\n",
    "  15. [FIX] rms_acc_lateral: ejes accel NO dominantes\n",
    "  16. [FIX] N_CICLOS_ESPERADOS y USAR_TOP_N en ConfigBaseline\n",
    "============================================================================\n",
    "\"\"\"\n",
    "\n",
    "import json\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.signal import butter, filtfilt, find_peaks\n",
    "from scipy.fft import fft, fftfreq\n",
    "from scipy.interpolate import interp1d\n",
    "import os\n",
    "from datetime import datetime\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# ========================================\n",
    "# 1. CONFIGURACIÓN GENERAL\n",
    "# ========================================\n",
    "class ConfigBaseline:\n",
    "    FS = 100\n",
    "    GYRO_LOWCUT = 0.1\n",
    "    GYRO_HIGHCUT = 10.0\n",
    "    ACCEL_CUTOFF = 5.0\n",
    "\n",
    "    PICO_PROMINENCE_FACTOR = 0.15\n",
    "    PICO_HEIGHT_FACTOR_POS = 0.15\n",
    "    PICO_HEIGHT_FACTOR_NEG = 0.15\n",
    "    PICO_MIN_DISTANCE = 15\n",
    "    PICO_WIDTH = 5\n",
    "\n",
    "    # [FIX 16]\n",
    "    N_CICLOS_ESPERADOS = 10\n",
    "    USAR_TOP_N = True\n",
    "\n",
    "    CICLOS_MIN_VALIDOS = 10\n",
    "    DURACION_MINIMA = 2.0\n",
    "    FS_TOLERANCE = 0.20\n",
    "\n",
    "    OUTPUT_BASE = \"./Pronacion Supinacion/baseline\"\n",
    "    OUTPUT_INDIVIDUAL = \"./Pronacion Supinacion/baseline/individual\"\n",
    "    OUTPUT_SUMMARY = \"./Pronacion Supinacion/baseline/summary\"\n",
    "\n",
    "\n",
    "# ========================================\n",
    "# 2. DETECCIÓN DE PRUEBA\n",
    "# ========================================\n",
    "def detectar_tipo_prueba(archivo_path, imu_data):\n",
    "    archivo_nombre = os.path.basename(archivo_path).lower()\n",
    "    dispositivos = set(d[\"deviceId\"] for d in imu_data if \"deviceId\" in d)\n",
    "    if \"right\" in archivo_nombre or \"derecha\" in archivo_nombre:\n",
    "        return \"right_only\", \"Mano derecha única\", list(dispositivos)\n",
    "    elif \"left\" in archivo_nombre or \"izquierda\" in archivo_nombre:\n",
    "        return \"left_only\", \"Mano izquierda única\", list(dispositivos)\n",
    "    elif \"both\" in archivo_nombre or \"ambas\" in archivo_nombre:\n",
    "        return \"both_hands\", \"Ambas manos\", list(dispositivos)\n",
    "    elif len(dispositivos) == 1:\n",
    "        return \"single_hand\", \"Mano única (detectada)\", list(dispositivos)\n",
    "    elif len(dispositivos) > 1:\n",
    "        return \"both_hands\", \"Ambas manos (detectada)\", list(dispositivos)\n",
    "    else:\n",
    "        return \"unknown\", \"Tipo desconocido\", list(dispositivos)\n",
    "\n",
    "\n",
    "def separar_por_dispositivo(imu_data):\n",
    "    disp = {}\n",
    "    for d in imu_data:\n",
    "        did = d.get(\"deviceId\", \"unknown\")\n",
    "        disp.setdefault(did, []).append(d)\n",
    "    return disp\n",
    "\n",
    "\n",
    "# ========================================\n",
    "# 3. PROCESAMIENTO\n",
    "# ========================================\n",
    "def validar_frecuencia_muestreo(time, config, debug=False):\n",
    "    if len(time) < 2:\n",
    "        return config.FS, False, \"Datos insuficientes\"\n",
    "    dt_real = np.median(np.diff(time))\n",
    "    fs_real = 1.0 / dt_real if dt_real > 0 else config.FS\n",
    "    desviacion = abs(fs_real - config.FS) / config.FS\n",
    "    advertencia = desviacion > config.FS_TOLERANCE\n",
    "    msg = (\n",
    "        f\"FS real: {fs_real:.1f} Hz (asumida: {config.FS}, desv: {desviacion*100:.1f}%)\"\n",
    "    )\n",
    "    if advertencia:\n",
    "        msg += \" ⚠️\"\n",
    "    if debug:\n",
    "        print(f\"  📊 {msg}\")\n",
    "    return fs_real, advertencia, msg\n",
    "\n",
    "\n",
    "def eliminar_duplicados_tiempo(time, signals_dict):\n",
    "    _, idx = np.unique(time, return_index=True)\n",
    "    idx = np.sort(idx)\n",
    "    return time[idx], {k: v[idx] for k, v in signals_dict.items()}, len(time) - len(idx)\n",
    "\n",
    "\n",
    "def remuestrear_uniforme(time, signals_dict, fs_target, debug=False):\n",
    "    time, signals_dict, n_rem = eliminar_duplicados_tiempo(time, signals_dict)\n",
    "    if debug and n_rem > 0:\n",
    "        print(f\"  ⚠️  Eliminados {n_rem} duplicados\")\n",
    "    if len(time) < 2:\n",
    "        raise ValueError(\"Datos insuficientes\")\n",
    "    time_u = np.linspace(time[0], time[-1], int((time[-1] - time[0]) * fs_target) + 1)\n",
    "    return time_u, {\n",
    "        k: interp1d(time, v, kind=\"cubic\", fill_value=\"extrapolate\")(time_u)\n",
    "        for k, v in signals_dict.items()\n",
    "    }\n",
    "\n",
    "\n",
    "# [FIX 13] Eje dominante por varianza real\n",
    "def detectar_eje_dominante_gyro(gx, gy, gz):\n",
    "    return max(\n",
    "        {\"gx\": gx, \"gy\": gy, \"gz\": gz},\n",
    "        key=lambda k: np.var({\"gx\": gx, \"gy\": gy, \"gz\": gz}[k]),\n",
    "    )\n",
    "\n",
    "\n",
    "def detectar_eje_dominante_accel(ax, ay, az):\n",
    "    return max(\n",
    "        {\"ax\": ax, \"ay\": ay, \"az\": az},\n",
    "        key=lambda k: np.var({\"ax\": ax, \"ay\": ay, \"az\": az}[k]),\n",
    "    )\n",
    "\n",
    "\n",
    "def procesar_dispositivo_baseline(datos, nombre_dispositivo, config, debug=False):\n",
    "    \"\"\"\n",
    "    [ALINEADO con pronosupina_analisis_completo]\n",
    "    - Usa fs_real consistentemente (resample + filtros + dt)\n",
    "    - Ángulo: lowpass(raw) → centrado → integración trapezoidal → highpass(0.05Hz)\n",
    "      para eliminar deriva de integración sin afectar la trayectoria.\n",
    "    \"\"\"\n",
    "    time = np.array([d[\"timestamp\"] for d in datos])\n",
    "    time = (time - time[0]) / 1000.0\n",
    "    fs_real, fs_warning, fs_msg = validar_frecuencia_muestreo(time, config, debug=debug)\n",
    "\n",
    "    gx = np.array([d.get(\"gyroscope\", {}).get(\"x\", 0) for d in datos])\n",
    "    gy = np.array([d.get(\"gyroscope\", {}).get(\"y\", 0) for d in datos])\n",
    "    gz = np.array([d.get(\"gyroscope\", {}).get(\"z\", 0) for d in datos])\n",
    "    ax = np.array([d.get(\"accelerometer\", {}).get(\"x\", 0) for d in datos])\n",
    "    ay = np.array([d.get(\"accelerometer\", {}).get(\"y\", 0) for d in datos])\n",
    "    az = np.array([d.get(\"accelerometer\", {}).get(\"z\", 0) for d in datos])\n",
    "\n",
    "    time_u, sr = remuestrear_uniforme(\n",
    "        time,\n",
    "        {\"gx\": gx, \"gy\": gy, \"gz\": gz, \"ax\": ax, \"ay\": ay, \"az\": az},\n",
    "        fs_real,\n",
    "        debug=debug,\n",
    "    )\n",
    "    if debug:\n",
    "        print(f\"  📐 {len(time)} → {len(time_u)} muestras a {fs_real:.1f} Hz\")\n",
    "\n",
    "    def bp(data, lo, hi, fs, order=4):\n",
    "        nyq = 0.5 * fs\n",
    "        b, a = butter(order, [lo / nyq, hi / nyq], btype=\"band\")\n",
    "        return filtfilt(b, a, data)\n",
    "\n",
    "    def lp(data, cut, fs, order=4):\n",
    "        nyq = 0.5 * fs\n",
    "        b, a = butter(order, cut / nyq, btype=\"low\")\n",
    "        return filtfilt(b, a, data)\n",
    "\n",
    "    def hp(data, cut, fs, order=1):\n",
    "        nyq = 0.5 * fs\n",
    "        b, a = butter(order, cut / nyq, btype=\"high\")\n",
    "        return filtfilt(b, a, data)\n",
    "\n",
    "    gx_f = bp(sr[\"gx\"], config.GYRO_LOWCUT, config.GYRO_HIGHCUT, fs_real)\n",
    "    gy_f = bp(sr[\"gy\"], config.GYRO_LOWCUT, config.GYRO_HIGHCUT, fs_real)\n",
    "    gz_f = bp(sr[\"gz\"], config.GYRO_LOWCUT, config.GYRO_HIGHCUT, fs_real)\n",
    "    ax_f = lp(sr[\"ax\"], config.ACCEL_CUTOFF, fs_real)\n",
    "    ay_f = lp(sr[\"ay\"], config.ACCEL_CUTOFF, fs_real)\n",
    "    az_f = lp(sr[\"az\"], config.ACCEL_CUTOFF, fs_real)\n",
    "\n",
    "    dt = 1.0 / fs_real\n",
    "\n",
    "    # Ángulo con eliminación de deriva (idéntico a pronosupina_analisis_completo)\n",
    "    gx_for_angle = lp(sr[\"gx\"], config.GYRO_HIGHCUT, fs_real)\n",
    "    gx_for_angle = gx_for_angle - np.mean(gx_for_angle)\n",
    "    angle_raw = np.insert(np.cumsum(0.5 * (gx_for_angle[:-1] + gx_for_angle[1:])) * dt, 0, 0.0)\n",
    "    angulo_x = hp(angle_raw, 0.05, fs_real, order=1)\n",
    "\n",
    "    return {\n",
    "        \"time\": time_u,\n",
    "        \"gx_raw\": sr[\"gx\"],\n",
    "        \"gy_raw\": sr[\"gy\"],\n",
    "        \"gz_raw\": sr[\"gz\"],\n",
    "        \"ax_raw\": sr[\"ax\"],\n",
    "        \"ay_raw\": sr[\"ay\"],\n",
    "        \"az_raw\": sr[\"az\"],\n",
    "        \"gx\": gx_f,\n",
    "        \"gy\": gy_f,\n",
    "        \"gz\": gz_f,\n",
    "        \"ax\": ax_f,\n",
    "        \"ay\": ay_f,\n",
    "        \"az\": az_f,\n",
    "        \"angulo_x\": angulo_x,\n",
    "        \"device_id\": nombre_dispositivo,\n",
    "        \"fs_real\": fs_real,\n",
    "        \"fs_warning\": fs_warning,\n",
    "        \"fs_msg\": fs_msg,\n",
    "    }\n",
    "\n",
    "\n",
    "# ========================================\n",
    "# 4. DETECCIÓN MEJORADA DE CICLOS\n",
    "# ========================================\n",
    "def seleccionar_top_n_picos(picos_pos, picos_neg, gx_signal, n_esperados=10):\n",
    "    \"\"\"[FIX 9] Llamar DESPUÉS de alternancia.\"\"\"\n",
    "    if len(picos_pos) > n_esperados:\n",
    "        idx = np.argsort(np.abs(gx_signal[picos_pos]))[::-1][:n_esperados]\n",
    "        picos_pos = np.sort(picos_pos[idx])\n",
    "    if len(picos_neg) > n_esperados:\n",
    "        idx = np.argsort(np.abs(gx_signal[picos_neg]))[::-1][:n_esperados]\n",
    "        picos_neg = np.sort(picos_neg[idx])\n",
    "    return picos_pos, picos_neg\n",
    "\n",
    "\n",
    "def detectar_ciclos_mejorado(gx_signal, time_signal, config, debug=False):\n",
    "    \"\"\"\n",
    "    Orden correcto:\n",
    "    1. Estrategia 1 (detección principal)\n",
    "    2. [FIX 10] Estrategia 2 rescata SOLO el tipo deficiente, ANTES de Top-N\n",
    "    3. Alternancia pos-neg (mayor amplitud)\n",
    "    4. [FIX 9]  Top-N DESPUÉS de alternancia\n",
    "    5. Emparejamiento greedy bidireccional\n",
    "    \"\"\"\n",
    "    rango = np.max(gx_signal) - np.min(gx_signal)\n",
    "    prom_min = rango * config.PICO_PROMINENCE_FACTOR\n",
    "\n",
    "    # ── Estrategia 1 ──────────────────────────────────────────────────────\n",
    "    picos_pos, _ = find_peaks(\n",
    "        gx_signal,\n",
    "        prominence=prom_min,\n",
    "        height=np.max(gx_signal) * config.PICO_HEIGHT_FACTOR_POS,\n",
    "        distance=config.PICO_MIN_DISTANCE,\n",
    "        width=config.PICO_WIDTH,\n",
    "    )\n",
    "    picos_neg, _ = find_peaks(\n",
    "        -gx_signal,\n",
    "        prominence=prom_min,\n",
    "        # [FIX 11] np.abs → robusto si señal está toda en un lado\n",
    "        height=np.abs(np.min(gx_signal)) * config.PICO_HEIGHT_FACTOR_NEG,\n",
    "        distance=config.PICO_MIN_DISTANCE,\n",
    "        width=config.PICO_WIDTH,\n",
    "    )\n",
    "\n",
    "    # ── [FIX 10] Estrategia 2: rescate SOLO del tipo deficiente ──────────\n",
    "    f = 0.5  # factor de rescate\n",
    "    if len(picos_pos) < 3:\n",
    "        if debug:\n",
    "            print(f\"  ⚠️  Pocos picos positivos ({len(picos_pos)}) → rescate\")\n",
    "        p2, _ = find_peaks(\n",
    "            gx_signal,\n",
    "            height=np.max(gx_signal) * config.PICO_HEIGHT_FACTOR_POS * f,\n",
    "            prominence=rango * config.PICO_PROMINENCE_FACTOR * f,\n",
    "            distance=config.PICO_MIN_DISTANCE,\n",
    "        )\n",
    "        if len(p2) > len(picos_pos):\n",
    "            picos_pos = p2\n",
    "\n",
    "    if len(picos_neg) < 3:\n",
    "        if debug:\n",
    "            print(f\"  ⚠️  Pocos picos negativos ({len(picos_neg)}) → rescate\")\n",
    "        n2, _ = find_peaks(\n",
    "            -gx_signal,\n",
    "            height=np.abs(np.min(gx_signal)) * config.PICO_HEIGHT_FACTOR_NEG * f,\n",
    "            prominence=rango * config.PICO_PROMINENCE_FACTOR * f,\n",
    "            distance=config.PICO_MIN_DISTANCE,\n",
    "        )\n",
    "        if len(n2) > len(picos_neg):\n",
    "            picos_neg = n2\n",
    "\n",
    "    # ── Alternancia pos-neg, conservar mayor amplitud ─────────────────────\n",
    "    todos = sorted(\n",
    "        [(\"pos\", int(p), gx_signal[p]) for p in picos_pos]\n",
    "        + [(\"neg\", int(p), gx_signal[p]) for p in picos_neg],\n",
    "        key=lambda x: x[1],\n",
    "    )\n",
    "    fp, fn = [], []\n",
    "    ut = ui = uv = None\n",
    "    for tipo, idx, val in todos:\n",
    "        if ut is None:\n",
    "            ut, ui, uv = tipo, idx, val\n",
    "        elif tipo != ut:\n",
    "            (fp if ut == \"pos\" else fn).append(ui)\n",
    "            ut, ui, uv = tipo, idx, val\n",
    "        else:\n",
    "            if abs(val) > abs(uv):\n",
    "                ui, uv = idx, val\n",
    "    if ut is not None:\n",
    "        (fp if ut == \"pos\" else fn).append(ui)\n",
    "\n",
    "    picos_pos = np.array(fp, dtype=int) if fp else np.array([], dtype=int)\n",
    "    picos_neg = np.array(fn, dtype=int) if fn else np.array([], dtype=int)\n",
    "\n",
    "    # ── [FIX 9] Top-N DESPUÉS de alternancia ─────────────────────────────\n",
    "    if config.USAR_TOP_N and config.N_CICLOS_ESPERADOS > 0:\n",
    "        picos_pos, picos_neg = seleccionar_top_n_picos(\n",
    "            picos_pos, picos_neg, gx_signal, config.N_CICLOS_ESPERADOS\n",
    "        )\n",
    "        if debug:\n",
    "            print(\n",
    "                f\"  🎯 Top-N ({config.N_CICLOS_ESPERADOS}): {len(picos_pos)} pos, {len(picos_neg)} neg\"\n",
    "            )\n",
    "\n",
    "    # ── Emparejamiento greedy bidireccional ───────────────────────────────\n",
    "    ciclos = emparejar_ciclos_por_tiempo(picos_pos, picos_neg, time_signal, gx_signal)\n",
    "\n",
    "    if debug:\n",
    "        print(\n",
    "            f\"  ✓ Picos pos: {len(picos_pos)} | Picos neg: {len(picos_neg)} | Ciclos: {len(ciclos)}\"\n",
    "        )\n",
    "        if len(picos_pos) > 1:\n",
    "            tp = np.diff(time_signal[picos_pos])\n",
    "            print(f\"  ⏱️  Pronación: {np.mean(tp):.2f} ± {np.std(tp):.2f} s\")\n",
    "        if len(picos_neg) > 1:\n",
    "            tn = np.diff(time_signal[picos_neg])\n",
    "            print(f\"  ⏱️  Supinación: {np.mean(tn):.2f} ± {np.std(tn):.2f} s\")\n",
    "\n",
    "    return picos_pos, picos_neg, len(ciclos), ciclos\n",
    "\n",
    "\n",
    "def emparejar_ciclos_por_tiempo(picos_pos, picos_neg, time_signal, gx_signal):\n",
    "    \"\"\"[FIX 2] Greedy bidireccional: mínima distancia temporal, sin restricción.\"\"\"\n",
    "    if len(picos_pos) == 0 or len(picos_neg) == 0:\n",
    "        return []\n",
    "    pares = sorted(\n",
    "        [\n",
    "            (abs(time_signal[n] - time_signal[p]), int(p), int(n))\n",
    "            for p in picos_pos\n",
    "            for n in picos_neg\n",
    "        ],\n",
    "        key=lambda x: x[0],\n",
    "    )\n",
    "    ciclos, up, un = [], set(), set()\n",
    "    for dist, p, n in pares:\n",
    "        if p not in up and n not in un:\n",
    "            up.add(p)\n",
    "            un.add(n)\n",
    "            ciclos.append(\n",
    "                {\n",
    "                    \"pos_idx\": p,\n",
    "                    \"neg_idx\": n,\n",
    "                    \"amplitud\": abs(gx_signal[p] - gx_signal[n]),\n",
    "                    \"tiempo_medio\": (time_signal[p] + time_signal[n]) / 2.0,\n",
    "                    \"duracion_ciclo\": abs(time_signal[n] - time_signal[p]),\n",
    "                }\n",
    "            )\n",
    "    ciclos.sort(key=lambda x: x[\"tiempo_medio\"])\n",
    "    return ciclos\n",
    "\n",
    "\n",
    "# ========================================\n",
    "# 5. ANÁLISIS DE VARIABLES\n",
    "# ========================================\n",
    "def analizar_variables_baseline(procesado, debug=False):\n",
    "    time = procesado[\"time\"]\n",
    "    gx, gy, gz = procesado[\"gx\"], procesado[\"gy\"], procesado[\"gz\"]\n",
    "    ax, ay, az = procesado[\"ax\"], procesado[\"ay\"], procesado[\"az\"]\n",
    "    angulo_x = procesado[\"angulo_x\"]\n",
    "    dt = 1.0 / procesado[\"fs_real\"]\n",
    "\n",
    "    # [FIX 13] Eje dominante real\n",
    "    eje_gyro_dom = detectar_eje_dominante_gyro(gx, gy, gz)\n",
    "    eje_accel_dom = detectar_eje_dominante_accel(ax, ay, az)\n",
    "    gyro_map = {\"gx\": gx, \"gy\": gy, \"gz\": gz}\n",
    "    accel_map = {\"ax\": ax, \"ay\": ay, \"az\": az}\n",
    "\n",
    "    picos_pos, picos_neg, n_ciclos, ciclos = detectar_ciclos_mejorado(\n",
    "        gx, time, ConfigBaseline, debug=debug\n",
    "    )\n",
    "\n",
    "    amplitudes = [c[\"amplitud\"] for c in ciclos]\n",
    "    tiempos_ciclo = [c[\"tiempo_medio\"] for c in ciclos]\n",
    "\n",
    "    amplitudes_angulares = [\n",
    "        abs(angulo_x[c[\"pos_idx\"]] - angulo_x[c[\"neg_idx\"]]) for c in ciclos\n",
    "    ]\n",
    "    velocidades_pico = [abs(gx[p]) for p in picos_pos] + [abs(gx[p]) for p in picos_neg]\n",
    "\n",
    "    # FFT (usar fs_real para frecuencias correctas)\n",
    "    N = len(gx)\n",
    "    yf = fft(gx)\n",
    "    xf = fftfreq(N, 1.0 / procesado[\"fs_real\"])[: N // 2]\n",
    "    power = np.abs(yf[: N // 2])\n",
    "    freq_dominante = float(xf[np.argmax(power[1:]) + 1]) if len(power) > 1 else 0.0\n",
    "\n",
    "    # Regularidad\n",
    "    regularidad = 0.0\n",
    "    if amplitudes and np.mean(amplitudes) > 0:\n",
    "        regularidad = max(\n",
    "            0.0, min(100.0, (1 - np.std(amplitudes) / np.mean(amplitudes)) * 100)\n",
    "        )\n",
    "\n",
    "    # [FIX 14] Compensación lateral: ejes gyro NO dominantes\n",
    "    lat_gyro = [v for k, v in gyro_map.items() if k != eje_gyro_dom]\n",
    "    compensacion_lateral = (\n",
    "        float(np.std(np.concatenate([e.reshape(-1) for e in lat_gyro])))\n",
    "        if lat_gyro\n",
    "        else 0.0\n",
    "    )\n",
    "\n",
    "    # Ejes\n",
    "    rango_x, rango_y, rango_z = float(np.ptp(gx)), float(np.ptp(gy)), float(np.ptp(gz))\n",
    "    eje_principal = max(\n",
    "        {\"ωx\": rango_x, \"ωy\": rango_y, \"ωz\": rango_z},\n",
    "        key=lambda k: {\"ωx\": rango_x, \"ωy\": rango_y, \"ωz\": rango_z}[k],\n",
    "    )\n",
    "\n",
    "    # [FIX 12] Cadencia desde picos_pos reales\n",
    "    cadencia = intervalo_real = 0.0\n",
    "    if len(picos_pos) > 1:\n",
    "        diffs = np.diff(time[picos_pos])\n",
    "        intervalo_real = float(np.mean(diffs))\n",
    "        if intervalo_real > 0:\n",
    "            cadencia = 1.0 / intervalo_real\n",
    "\n",
    "    # Métricas nivel 2\n",
    "    # [FIX 13] Jerk lineal del eje accel dominante\n",
    "    jerk_lin = np.gradient(accel_map[eje_accel_dom], dt)\n",
    "    jerk_rms_lineal = float(np.sqrt(np.mean(jerk_lin**2)))\n",
    "\n",
    "    jerk_ang = np.gradient(gx, dt)\n",
    "    jerk_rms_angular = float(np.sqrt(np.mean(jerk_ang**2)))\n",
    "\n",
    "    # [FIX 15] RMS acc lateral: ejes NO dominantes\n",
    "    lat_accel = [v for k, v in accel_map.items() if k != eje_accel_dom]\n",
    "    rms_acc_lateral = (\n",
    "        float(np.sqrt(np.mean(np.sum([e**2 for e in lat_accel], axis=0))))\n",
    "        if lat_accel\n",
    "        else 0.0\n",
    "    )\n",
    "\n",
    "    # [FIX 13] Energía eje dominante gyro\n",
    "    e_dom = float(np.mean(gyro_map[eje_gyro_dom] ** 2))\n",
    "    e_total = float(np.mean(gx**2) + np.mean(gy**2) + np.mean(gz**2))\n",
    "    energia_relativa = e_dom / e_total if e_total > 0 else 0.0\n",
    "\n",
    "    rango_angular = float(np.ptp(angulo_x))\n",
    "\n",
    "    return {\n",
    "        \"device_id\": procesado[\"device_id\"],\n",
    "        \"n_ciclos\": int(n_ciclos),\n",
    "        \"duracion\": float(time[-1] - time[0]) if len(time) > 1 else 0.0,\n",
    "        \"fs_real\": float(procesado[\"fs_real\"]),\n",
    "        \"fs_warning\": bool(procesado[\"fs_warning\"]),\n",
    "        \"eje_gyro_dom\": eje_gyro_dom,\n",
    "        \"eje_accel_dom\": eje_accel_dom,\n",
    "        \"amplitud_media\": float(np.mean(amplitudes)) if amplitudes else 0.0,\n",
    "        \"amplitud_std\": float(np.std(amplitudes)) if amplitudes else 0.0,\n",
    "        \"amplitud_cv\": (\n",
    "            float(np.std(amplitudes) / np.mean(amplitudes))\n",
    "            if amplitudes and np.mean(amplitudes) > 0\n",
    "            else 0.0\n",
    "        ),\n",
    "        \"amplitud_max\": float(np.max(amplitudes)) if amplitudes else 0.0,\n",
    "        \"amplitud_min\": float(np.min(amplitudes)) if amplitudes else 0.0,\n",
    "        \"amplitud_angular_media\": (\n",
    "            float(np.mean(amplitudes_angulares)) if amplitudes_angulares else 0.0\n",
    "        ),\n",
    "        \"amplitud_angular_std\": (\n",
    "            float(np.std(amplitudes_angulares)) if amplitudes_angulares else 0.0\n",
    "        ),\n",
    "        \"amplitud_angular_max\": (\n",
    "            float(np.max(amplitudes_angulares)) if amplitudes_angulares else 0.0\n",
    "        ),\n",
    "        \"rango_angular_total\": rango_angular,\n",
    "        \"velocidad_pico_media\": (\n",
    "            float(np.mean(velocidades_pico)) if velocidades_pico else 0.0\n",
    "        ),\n",
    "        \"velocidad_pico_max\": (\n",
    "            float(np.max(velocidades_pico)) if velocidades_pico else 0.0\n",
    "        ),\n",
    "        \"velocidad_pico_std\": (\n",
    "            float(np.std(velocidades_pico)) if velocidades_pico else 0.0\n",
    "        ),\n",
    "        \"frecuencia\": freq_dominante,\n",
    "        \"cadencia\": float(cadencia),\n",
    "        \"intervalo_medio\": intervalo_real,  # [FIX 12] desde picos reales\n",
    "        \"regularidad\": float(regularidad),\n",
    "        \"compensacion_lateral\": compensacion_lateral,\n",
    "        \"eje_principal\": eje_principal,\n",
    "        \"rango_ωx\": rango_x,\n",
    "        \"rango_ωy\": rango_y,\n",
    "        \"rango_ωz\": rango_z,\n",
    "        \"picos_pos\": picos_pos.tolist(),\n",
    "        \"picos_neg\": picos_neg.tolist(),\n",
    "        \"ciclos_pareados\": ciclos,\n",
    "        \"jerk_rms\": jerk_rms_lineal,\n",
    "        \"jerk_rms_angular\": jerk_rms_angular,\n",
    "        \"rms_acc_lateral\": rms_acc_lateral,\n",
    "        \"energia_relativa_x\": energia_relativa,  # nombre conservado\n",
    "        \"valido\": bool(\n",
    "            n_ciclos >= ConfigBaseline.CICLOS_MIN_VALIDOS\n",
    "            and (time[-1] - time[0]) >= ConfigBaseline.DURACION_MINIMA\n",
    "        ),\n",
    "    }\n",
    "\n",
    "\n",
    "# ========================================\n",
    "# 6. VISUALIZACIÓN\n",
    "# ========================================\n",
    "def graficar_señales_completas(procesado, variables, output_path, sujeto_id):\n",
    "    fig = plt.figure(figsize=(24, 22))\n",
    "    ciclos = variables.get(\"ciclos_pareados\", [])\n",
    "    dt = 1.0 / ConfigBaseline.FS\n",
    "    pp = np.array(variables[\"picos_pos\"], dtype=int)\n",
    "    pn = np.array(variables[\"picos_neg\"], dtype=int)\n",
    "    accel_map = {\"ax\": procesado[\"ax\"], \"ay\": procesado[\"ay\"], \"az\": procesado[\"az\"]}\n",
    "    accel_dom_sig = accel_map[variables[\"eje_accel_dom\"]]\n",
    "\n",
    "    # 1. ωx + detección (2 cols)\n",
    "    ax1 = plt.subplot(6, 4, (1, 2))\n",
    "    ax1.plot(\n",
    "        procesado[\"time\"], procesado[\"gx\"], \"b-\", lw=1.5, alpha=0.7, label=\"ωx filtrada\"\n",
    "    )\n",
    "    ax1.plot(\n",
    "        procesado[\"time\"],\n",
    "        procesado[\"gx_raw\"],\n",
    "        \"b--\",\n",
    "        lw=0.8,\n",
    "        alpha=0.3,\n",
    "        label=\"ωx cruda\",\n",
    "    )\n",
    "    if len(pp):\n",
    "        ax1.plot(\n",
    "            procesado[\"time\"][pp],\n",
    "            procesado[\"gx\"][pp],\n",
    "            \"ro\",\n",
    "            ms=8,\n",
    "            mec=\"black\",\n",
    "            label=f\"Pronación ({len(pp)})\",\n",
    "        )\n",
    "    if len(pn):\n",
    "        ax1.plot(\n",
    "            procesado[\"time\"][pn],\n",
    "            procesado[\"gx\"][pn],\n",
    "            \"go\",\n",
    "            ms=8,\n",
    "            mec=\"black\",\n",
    "            label=f\"Supinación ({len(pn)})\",\n",
    "        )\n",
    "    for c in ciclos:\n",
    "        ax1.plot(\n",
    "            [procesado[\"time\"][c[\"pos_idx\"]], procesado[\"time\"][c[\"neg_idx\"]]],\n",
    "            [procesado[\"gx\"][c[\"pos_idx\"]], procesado[\"gx\"][c[\"neg_idx\"]]],\n",
    "            \"k-\",\n",
    "            alpha=0.15,\n",
    "            lw=0.8,\n",
    "        )\n",
    "    ax1.axhline(\n",
    "        np.max(procesado[\"gx\"]) * ConfigBaseline.PICO_HEIGHT_FACTOR_POS,\n",
    "        color=\"red\",\n",
    "        ls=\":\",\n",
    "        alpha=0.5,\n",
    "        label=\"Umbral pron.\",\n",
    "    )\n",
    "    ax1.axhline(\n",
    "        -np.abs(np.min(procesado[\"gx\"])) * ConfigBaseline.PICO_HEIGHT_FACTOR_NEG,\n",
    "        color=\"green\",\n",
    "        ls=\":\",\n",
    "        alpha=0.5,\n",
    "        label=\"Umbral sup.\",\n",
    "    )\n",
    "    ax1.set_title(\n",
    "        f'GIROSCOPIO ωx – {variables[\"n_ciclos\"]} ciclos pareados',\n",
    "        fontsize=12,\n",
    "        fontweight=\"bold\",\n",
    "    )\n",
    "    ax1.set_xlabel(\"Tiempo [s]\", fontsize=10)\n",
    "    ax1.set_ylabel(\"ωx [°/s]\", fontsize=10, fontweight=\"bold\")\n",
    "    ax1.grid(True, alpha=0.3)\n",
    "    ax1.legend(loc=\"upper right\", fontsize=7)\n",
    "    ax1.axhline(0, color=\"black\", ls=\"--\", alpha=0.3)\n",
    "\n",
    "    # 2. Ángulo (2 cols)\n",
    "    ax2 = plt.subplot(6, 4, (3, 4))\n",
    "    ax2.plot(\n",
    "        procesado[\"time\"],\n",
    "        procesado[\"angulo_x\"],\n",
    "        \"purple\",\n",
    "        lw=1.5,\n",
    "        alpha=0.8,\n",
    "        label=f'θx (rango: {variables[\"rango_angular_total\"]:.1f}°)',\n",
    "    )\n",
    "    if len(pp):\n",
    "        ax2.plot(\n",
    "            procesado[\"time\"][pp], procesado[\"angulo_x\"][pp], \"ro\", ms=6, alpha=0.7\n",
    "        )\n",
    "    if len(pn):\n",
    "        ax2.plot(\n",
    "            procesado[\"time\"][pn], procesado[\"angulo_x\"][pn], \"go\", ms=6, alpha=0.7\n",
    "        )\n",
    "    ax2.set_title(\n",
    "        f'ÁNGULO DE ROTACIÓN θx (amp media: {variables[\"amplitud_angular_media\"]:.1f}°)',\n",
    "        fontsize=12,\n",
    "        fontweight=\"bold\",\n",
    "    )\n",
    "    ax2.set_xlabel(\"Tiempo [s]\", fontsize=10)\n",
    "    ax2.set_ylabel(\"Ángulo [°]\", fontsize=10, fontweight=\"bold\")\n",
    "    ax2.grid(True, alpha=0.3)\n",
    "    ax2.legend(fontsize=8)\n",
    "    ax2.axhline(0, color=\"black\", ls=\"--\", alpha=0.3)\n",
    "\n",
    "    # 3. ay\n",
    "    ax3 = plt.subplot(6, 4, 5)\n",
    "    ax3.plot(\n",
    "        procesado[\"time\"], procesado[\"ay\"], \"g-\", lw=1.5, alpha=0.8, label=\"ay filt\"\n",
    "    )\n",
    "    ax3.plot(\n",
    "        procesado[\"time\"],\n",
    "        procesado[\"ay_raw\"],\n",
    "        \"g--\",\n",
    "        lw=0.8,\n",
    "        alpha=0.3,\n",
    "        label=\"ay cruda\",\n",
    "    )\n",
    "    ax3.set_title(\"ACELERÓMETRO ay\", fontsize=10, fontweight=\"bold\")\n",
    "    ax3.set_xlabel(\"Tiempo [s]\", fontsize=9)\n",
    "    ax3.set_ylabel(\"ay [g]\", fontsize=9)\n",
    "    ax3.grid(True, alpha=0.3)\n",
    "    ax3.legend(fontsize=7)\n",
    "    ax3.axhline(0, color=\"black\", ls=\"--\", alpha=0.3)\n",
    "\n",
    "    # 4. ωy\n",
    "    ax4 = plt.subplot(6, 4, 6)\n",
    "    ax4.plot(procesado[\"time\"], procesado[\"gy\"], \"g-\", lw=1.5)\n",
    "    ax4.set_title(\"GIROSCOPIO: ωy\", fontsize=10, fontweight=\"bold\")\n",
    "    ax4.set_xlabel(\"Tiempo [s]\", fontsize=9)\n",
    "    ax4.set_ylabel(\"ωy [°/s]\", fontsize=9)\n",
    "    ax4.grid(True, alpha=0.3)\n",
    "    ax4.axhline(0, color=\"red\", ls=\"--\", alpha=0.3)\n",
    "\n",
    "    # 5. ωz\n",
    "    ax5 = plt.subplot(6, 4, 7)\n",
    "    ax5.plot(procesado[\"time\"], procesado[\"gz\"], \"r-\", lw=1.5)\n",
    "    ax5.set_title(\"GIROSCOPIO: ωz\", fontsize=10, fontweight=\"bold\")\n",
    "    ax5.set_xlabel(\"Tiempo [s]\", fontsize=9)\n",
    "    ax5.set_ylabel(\"ωz [°/s]\", fontsize=9)\n",
    "    ax5.grid(True, alpha=0.3)\n",
    "    ax5.axhline(0, color=\"red\", ls=\"--\", alpha=0.3)\n",
    "\n",
    "    # 6. FFT\n",
    "    ax6 = plt.subplot(6, 4, 8)\n",
    "    N = len(procesado[\"gx\"])\n",
    "    yf = fft(procesado[\"gx\"])\n",
    "    xf = fftfreq(N, 1.0 / ConfigBaseline.FS)[: N // 2]\n",
    "    ax6.plot(xf[1:], np.abs(yf[: N // 2])[1:], \"b-\", lw=1.5)\n",
    "    if variables[\"frecuencia\"] > 0:\n",
    "        ax6.axvline(\n",
    "            variables[\"frecuencia\"],\n",
    "            color=\"red\",\n",
    "            ls=\"--\",\n",
    "            alpha=0.7,\n",
    "            label=f'{variables[\"frecuencia\"]:.2f} Hz',\n",
    "        )\n",
    "    ax6.set_title(\"ESPECTRO: ωx\", fontsize=10, fontweight=\"bold\")\n",
    "    ax6.set_xlabel(\"Frecuencia [Hz]\", fontsize=9)\n",
    "    ax6.set_ylabel(\"Magnitud\", fontsize=9)\n",
    "    ax6.set_xlim([0, 5])\n",
    "    ax6.grid(True, alpha=0.3)\n",
    "    ax6.legend(fontsize=8)\n",
    "\n",
    "    # 7. Histograma amplitudes\n",
    "    ax7 = plt.subplot(6, 4, 9)\n",
    "    if ciclos:\n",
    "        amps = [c[\"amplitud\"] for c in ciclos]\n",
    "        ax7.hist(amps, bins=min(10, len(amps)), alpha=0.7, color=\"skyblue\", ec=\"black\")\n",
    "        ax7.axvline(\n",
    "            np.mean(amps),\n",
    "            color=\"red\",\n",
    "            ls=\"--\",\n",
    "            lw=2,\n",
    "            label=f\"Media: {np.mean(amps):.1f}°/s\",\n",
    "        )\n",
    "        ax7.set_title(\"DISTRIBUCIÓN AMPLITUDES\", fontsize=10, fontweight=\"bold\")\n",
    "        ax7.set_xlabel(\"Amplitud [°/s]\", fontsize=9)\n",
    "        ax7.set_ylabel(\"Frec.\", fontsize=9)\n",
    "        ax7.grid(True, alpha=0.3, axis=\"y\")\n",
    "        ax7.legend(fontsize=8)\n",
    "\n",
    "    # 8. ax\n",
    "    ax8 = plt.subplot(6, 4, 10)\n",
    "    ax8.plot(procesado[\"time\"], procesado[\"ax\"], \"b-\", lw=1.5, alpha=0.8)\n",
    "    ax8.plot(procesado[\"time\"], procesado[\"ax_raw\"], \"b--\", lw=0.8, alpha=0.3)\n",
    "    ax8.set_title(\"ACELERÓMETRO: ax\", fontsize=10, fontweight=\"bold\")\n",
    "    ax8.set_xlabel(\"Tiempo [s]\", fontsize=9)\n",
    "    ax8.set_ylabel(\"ax [g]\", fontsize=9)\n",
    "    ax8.grid(True, alpha=0.3)\n",
    "    ax8.axhline(0, color=\"red\", ls=\"--\", alpha=0.3)\n",
    "\n",
    "    # 9. az\n",
    "    ax9 = plt.subplot(6, 4, 11)\n",
    "    ax9.plot(procesado[\"time\"], procesado[\"az\"], \"r-\", lw=1.5, alpha=0.8)\n",
    "    ax9.plot(procesado[\"time\"], procesado[\"az_raw\"], \"r--\", lw=0.8, alpha=0.3)\n",
    "    ax9.set_title(\"ACELERÓMETRO: az\", fontsize=10, fontweight=\"bold\")\n",
    "    ax9.set_xlabel(\"Tiempo [s]\", fontsize=9)\n",
    "    ax9.set_ylabel(\"az [g]\", fontsize=9)\n",
    "    ax9.grid(True, alpha=0.3)\n",
    "    ax9.axhline(0, color=\"red\", ls=\"--\", alpha=0.3)\n",
    "\n",
    "    # 10. Magnitud accel\n",
    "    ax10 = plt.subplot(6, 4, 12)\n",
    "    mag = np.sqrt(procesado[\"ax\"] ** 2 + procesado[\"ay\"] ** 2 + procesado[\"az\"] ** 2)\n",
    "    mag_r = np.sqrt(\n",
    "        procesado[\"ax_raw\"] ** 2 + procesado[\"ay_raw\"] ** 2 + procesado[\"az_raw\"] ** 2\n",
    "    )\n",
    "    ax10.plot(procesado[\"time\"], mag, \"purple\", lw=1.5, alpha=0.8, label=\"Filtrada\")\n",
    "    ax10.plot(procesado[\"time\"], mag_r, \"purple\", lw=0.8, alpha=0.3, label=\"Cruda\")\n",
    "    ax10.axhline(1.0, color=\"red\", ls=\"--\", alpha=0.5, label=\"1g\")\n",
    "    ax10.set_title(\"MAGNITUD ACELERACIÓN\", fontsize=10, fontweight=\"bold\")\n",
    "    ax10.set_xlabel(\"Tiempo [s]\", fontsize=9)\n",
    "    ax10.set_ylabel(\"|a| [g]\", fontsize=9)\n",
    "    ax10.grid(True, alpha=0.3)\n",
    "    ax10.legend(fontsize=8)\n",
    "\n",
    "    # 11. Jerk angular\n",
    "    ax11 = plt.subplot(6, 4, 13)\n",
    "    ax11.plot(procesado[\"time\"], np.gradient(procesado[\"gx\"], dt), \"darkorange\", lw=1.3)\n",
    "    ax11.set_title(\n",
    "        f'JERK ANGULAR (RMS={variables[\"jerk_rms_angular\"]:.1f}°/s²)',\n",
    "        fontsize=10,\n",
    "        fontweight=\"bold\",\n",
    "    )\n",
    "    ax11.set_xlabel(\"Tiempo [s]\", fontsize=9)\n",
    "    ax11.set_ylabel(\"°/s²\", fontsize=9)\n",
    "    ax11.grid(True, alpha=0.3)\n",
    "\n",
    "    # 12. Jerk lineal (eje accel dominante)\n",
    "    ax12 = plt.subplot(6, 4, 14)\n",
    "    ax12.plot(procesado[\"time\"], np.gradient(accel_dom_sig, dt), \"m-\", lw=1.3)\n",
    "    ax12.set_title(\n",
    "        f'JERK LINEAL [{variables[\"eje_accel_dom\"]}] (RMS={variables[\"jerk_rms\"]:.3f} g/s)',\n",
    "        fontsize=10,\n",
    "        fontweight=\"bold\",\n",
    "    )\n",
    "    ax12.set_xlabel(\"Tiempo [s]\", fontsize=9)\n",
    "    ax12.set_ylabel(\"g/s\", fontsize=9)\n",
    "    ax12.grid(True, alpha=0.3)\n",
    "\n",
    "    # 13. Evolución amplitudes\n",
    "    ax13 = plt.subplot(6, 4, 15)\n",
    "    if ciclos:\n",
    "        ae = [c[\"amplitud\"] for c in ciclos]\n",
    "        te = [c[\"tiempo_medio\"] for c in ciclos]\n",
    "        ax13.plot(te, ae, \"bo-\", lw=1.5, ms=5)\n",
    "        if len(ae) > 2:\n",
    "            z = np.polyfit(te, ae, 1)\n",
    "            ax13.plot(\n",
    "                te, np.poly1d(z)(te), \"r--\", alpha=0.7, label=f\"Tend: {z[0]:.2f}°/s²\"\n",
    "            )\n",
    "            ax13.legend(fontsize=8)\n",
    "        ax13.set_title(\"EVOLUCIÓN AMPLITUDES\", fontsize=10, fontweight=\"bold\")\n",
    "        ax13.set_xlabel(\"Tiempo [s]\", fontsize=9)\n",
    "        ax13.set_ylabel(\"°/s\", fontsize=9)\n",
    "        ax13.grid(True, alpha=0.3)\n",
    "\n",
    "    # 14. Velocidades pico\n",
    "    ax14 = plt.subplot(6, 4, 16)\n",
    "    if ciclos:\n",
    "        vp = [abs(procesado[\"gx\"][c[\"pos_idx\"]]) for c in ciclos]\n",
    "        vn = [abs(procesado[\"gx\"][c[\"neg_idx\"]]) for c in ciclos]\n",
    "        tv = [c[\"tiempo_medio\"] for c in ciclos]\n",
    "        ax14.plot(tv, vp, \"ro-\", lw=1.5, ms=4, label=\"Pronación\")\n",
    "        ax14.plot(tv, vn, \"go-\", lw=1.5, ms=4, label=\"Supinación\")\n",
    "        ax14.set_title(\"VELOCIDADES PICO\", fontsize=10, fontweight=\"bold\")\n",
    "        ax14.set_xlabel(\"Tiempo [s]\", fontsize=9)\n",
    "        ax14.set_ylabel(\"°/s\", fontsize=9)\n",
    "        ax14.grid(True, alpha=0.3)\n",
    "        ax14.legend(fontsize=8)\n",
    "\n",
    "    # 15. ωx vs ay\n",
    "    ax15 = plt.subplot(6, 4, 17)\n",
    "    sc = ax15.scatter(\n",
    "        procesado[\"gx\"],\n",
    "        procesado[\"ay\"],\n",
    "        c=procesado[\"time\"],\n",
    "        cmap=\"viridis\",\n",
    "        alpha=0.6,\n",
    "        s=10,\n",
    "    )\n",
    "    ax15.set_title(\"Rotación vs Compensación\", fontsize=10, fontweight=\"bold\")\n",
    "    ax15.set_xlabel(\"ωx [°/s]\", fontsize=9)\n",
    "    ax15.set_ylabel(\"ay [g]\", fontsize=9)\n",
    "    ax15.grid(True, alpha=0.3)\n",
    "    ax15.axhline(0, color=\"red\", ls=\"--\", alpha=0.3)\n",
    "    ax15.axvline(0, color=\"red\", ls=\"--\", alpha=0.3)\n",
    "    plt.colorbar(sc, ax=ax15, label=\"Tiempo [s]\")\n",
    "\n",
    "    # 16. Accel lateral\n",
    "    ax16 = plt.subplot(6, 4, 18)\n",
    "    ax16.plot(procesado[\"time\"], procesado[\"ay\"], label=\"ay\", alpha=0.7)\n",
    "    ax16.plot(procesado[\"time\"], procesado[\"az\"], label=\"az\", alpha=0.7)\n",
    "    ax16.set_title(\n",
    "        f'ACC LATERAL RMS={variables[\"rms_acc_lateral\"]:.3f}g',\n",
    "        fontsize=10,\n",
    "        fontweight=\"bold\",\n",
    "    )\n",
    "    ax16.set_xlabel(\"Tiempo [s]\", fontsize=9)\n",
    "    ax16.set_ylabel(\"g\", fontsize=9)\n",
    "    ax16.legend(fontsize=8)\n",
    "    ax16.grid(True, alpha=0.3)\n",
    "\n",
    "    # 17. Tabla\n",
    "    ax17 = plt.subplot(6, 4, (19, 24))\n",
    "    ax17.axis(\"off\")\n",
    "    asm = f\"{variables['amplitud_cv']*100:.1f}%\" if variables[\"n_ciclos\"] > 0 else \"N/A\"\n",
    "    tabla_datos = [\n",
    "        [\"MÉTRICA\", \"VALOR\", \"INTERPRETACIÓN\"],\n",
    "        [\n",
    "            \"FS real\",\n",
    "            f\"{variables['fs_real']:.1f} Hz\",\n",
    "            \"✓\" if not variables[\"fs_warning\"] else \"⚠️\",\n",
    "        ],\n",
    "        [\n",
    "            \"Ciclos pareados\",\n",
    "            f\"{variables['n_ciclos']}\",\n",
    "            f\"Mín {ConfigBaseline.CICLOS_MIN_VALIDOS}\",\n",
    "        ],\n",
    "        [\n",
    "            \"Duración [s]\",\n",
    "            f\"{variables['duracion']:.1f}\",\n",
    "            f\"Mín {ConfigBaseline.DURACION_MINIMA}s\",\n",
    "        ],\n",
    "        [\n",
    "            \"Eje dom.\",\n",
    "            f\"{variables['eje_gyro_dom']} / {variables['eje_accel_dom']}\",\n",
    "            \"Gyro/Accel\",\n",
    "        ],\n",
    "        [\n",
    "            \"Amplitud media\",\n",
    "            f\"{variables['amplitud_media']:.1f} °/s\",\n",
    "            f\"±{variables['amplitud_std']:.1f}\",\n",
    "        ],\n",
    "        [\n",
    "            \"Amp. angular\",\n",
    "            f\"{variables['amplitud_angular_media']:.1f}°\",\n",
    "            f\"±{variables['amplitud_angular_std']:.1f}°\",\n",
    "        ],\n",
    "        [\"Rango angular\", f\"{variables['rango_angular_total']:.1f}°\", \"Rango total θx\"],\n",
    "        [\"CV amplitud\", f\"{variables['amplitud_cv']:.3f}\", asm],\n",
    "        [\n",
    "            \"Velocidad pico\",\n",
    "            f\"{variables['velocidad_pico_media']:.1f} °/s\",\n",
    "            f\"Max {variables['velocidad_pico_max']:.1f}\",\n",
    "        ],\n",
    "        [\n",
    "            \"Frecuencia\",\n",
    "            f\"{variables['frecuencia']:.2f} Hz\",\n",
    "            f\"Cadencia {variables['cadencia']:.2f} Hz\",\n",
    "        ],\n",
    "        [\n",
    "            \"Intervalo ciclo\",\n",
    "            f\"{variables['intervalo_medio']*1000:.0f} ms\",\n",
    "            \"Desde picos pron.\",\n",
    "        ],\n",
    "        [\"Regularidad\", f\"{variables['regularidad']:.1f}%\", \"100%=perfecta\"],\n",
    "        [\n",
    "            \"Compensación lat.\",\n",
    "            f\"{variables['compensacion_lateral']:.3f}\",\n",
    "            \"Gyro ejes no dom.\",\n",
    "        ],\n",
    "        [\n",
    "            \"Eje principal\",\n",
    "            variables[\"eje_principal\"],\n",
    "            f\"ωx={variables['rango_ωx']:.0f}°/s\",\n",
    "        ],\n",
    "        [\n",
    "            \"Jerk angular RMS\",\n",
    "            f\"{variables['jerk_rms_angular']:.1f} °/s²\",\n",
    "            \"Suavidad rotación\",\n",
    "        ],\n",
    "        [\n",
    "            \"Jerk lineal RMS\",\n",
    "            f\"{variables['jerk_rms']:.3f} g/s\",\n",
    "            f\"Eje {variables['eje_accel_dom']}\",\n",
    "        ],\n",
    "        [\n",
    "            \"RMS acc lateral\",\n",
    "            f\"{variables['rms_acc_lateral']:.3f} g\",\n",
    "            \"Ejes no dominantes\",\n",
    "        ],\n",
    "        [\n",
    "            \"Energía eje dom.\",\n",
    "            f\"{variables['energia_relativa_x']:.2f}\",\n",
    "            f\"Control {variables['eje_gyro_dom']}\",\n",
    "        ],\n",
    "        [\n",
    "            \"Estado\",\n",
    "            \"VÁLIDO\" if variables[\"valido\"] else \"INSUFICIENTE\",\n",
    "            \"✓\" if variables[\"valido\"] else \"✗\",\n",
    "        ],\n",
    "    ]\n",
    "    tabla = ax17.table(cellText=tabla_datos, loc=\"center\", cellLoc=\"left\")\n",
    "    tabla.auto_set_font_size(False)\n",
    "    tabla.set_fontsize(8)\n",
    "    tabla.scale(1.0, 1.5)\n",
    "    for i in range(len(tabla_datos)):\n",
    "        for j in range(3):\n",
    "            cell = tabla[(i, j)]\n",
    "            cell.set_edgecolor(\"gray\")\n",
    "            if i == 0:\n",
    "                cell.set_facecolor(\"#2c3e50\")\n",
    "                cell.set_text_props(weight=\"bold\", color=\"white\", fontsize=9)\n",
    "            elif i == len(tabla_datos) - 1:\n",
    "                cell.set_facecolor(\"#d4edda\" if variables[\"valido\"] else \"#f8d7da\")\n",
    "                cell.set_text_props(weight=\"bold\")\n",
    "            elif i == 1:\n",
    "                cell.set_facecolor(\n",
    "                    \"#d4edda\" if not variables[\"fs_warning\"] else \"#fff3cd\"\n",
    "                )\n",
    "            elif i == 2:\n",
    "                cell.set_facecolor(\n",
    "                    \"#d4edda\"\n",
    "                    if variables[\"n_ciclos\"] >= 10\n",
    "                    else \"#fff3cd\" if variables[\"n_ciclos\"] >= 5 else \"#f8d7da\"\n",
    "                )\n",
    "\n",
    "    plt.suptitle(\n",
    "        f'ANÁLISIS BASELINE – {procesado[\"device_id\"]} | Sujeto: {sujeto_id}',\n",
    "        fontsize=14,\n",
    "        fontweight=\"bold\",\n",
    "        y=0.995,\n",
    "    )\n",
    "    plt.tight_layout()\n",
    "    os.makedirs(os.path.dirname(output_path), exist_ok=True)\n",
    "    plt.savefig(output_path, dpi=150, bbox_inches=\"tight\")\n",
    "    plt.close()\n",
    "    print(f\"   ✓ Gráfica: {os.path.basename(output_path)}\")\n",
    "    return output_path\n",
    "\n",
    "\n",
    "# ========================================\n",
    "# 7. FUNCIÓN PRINCIPAL\n",
    "# ========================================\n",
    "def analisis_baseline_pronacion(archivo_path, debug=False):\n",
    "    print(\"\\n\" + \"=\" * 80 + \"\\nANÁLISIS BASELINE: PRONACIÓN-SUPINACIÓN\\n\" + \"=\" * 80)\n",
    "    config = ConfigBaseline\n",
    "    for d in [config.OUTPUT_BASE, config.OUTPUT_INDIVIDUAL, config.OUTPUT_SUMMARY]:\n",
    "        os.makedirs(d, exist_ok=True)\n",
    "\n",
    "    print(f\"\\n📁 CARGANDO: {os.path.basename(archivo_path)}\")\n",
    "    try:\n",
    "        with open(archivo_path, \"r\") as f:\n",
    "            data = json.load(f)\n",
    "        imu_data = data.get(\"imuData\", [])\n",
    "        print(f\"   ✓ Muestras: {len(imu_data)}\")\n",
    "    except Exception as e:\n",
    "        print(f\"   ✗ ERROR: {e}\")\n",
    "        return None\n",
    "\n",
    "    tipo_prueba, descripcion, dispositivos = detectar_tipo_prueba(\n",
    "        archivo_path, imu_data\n",
    "    )\n",
    "    print(f\"\\n🔍 {descripcion} | Disp: {', '.join(dispositivos) or 'Ninguno'}\")\n",
    "    datos_por_disp = separar_por_dispositivo(imu_data)\n",
    "    if not datos_por_disp:\n",
    "        print(\"   ✗ Sin datos\")\n",
    "        return None\n",
    "\n",
    "    resultados = {}\n",
    "    variables_totales = {}\n",
    "    sujeto_id = os.path.splitext(os.path.basename(archivo_path))[0]\n",
    "\n",
    "    for device_id, datos in datos_por_disp.items():\n",
    "        print(f\"\\n   • {device_id}: {len(datos)} muestras\")\n",
    "        procesado = procesar_dispositivo_baseline(datos, device_id, config, debug=debug)\n",
    "        variables = analizar_variables_baseline(procesado, debug=debug)\n",
    "        grafico_path = os.path.join(\n",
    "            config.OUTPUT_INDIVIDUAL, f\"{sujeto_id}_{device_id}_baseline_DETALLADO.png\"\n",
    "        )\n",
    "        grafico_guardado = graficar_señales_completas(\n",
    "            procesado, variables, grafico_path, sujeto_id\n",
    "        )\n",
    "        resultados[device_id] = {\n",
    "            \"procesado\": procesado,\n",
    "            \"variables\": variables,\n",
    "            \"grafico\": grafico_guardado,\n",
    "        }\n",
    "        variables_totales[device_id] = variables\n",
    "        v = variables\n",
    "        print(\n",
    "            f\"     ✓ Ciclos: {v['n_ciclos']} | Amp: {v['amplitud_media']:.1f} °/s | Cadencia: {v['cadencia']:.2f} Hz\"\n",
    "        )\n",
    "        print(\n",
    "            f\"     ✓ Intervalo: {v['intervalo_medio']*1000:.0f} ms | Regular: {v['regularidad']:.1f}%\"\n",
    "        )\n",
    "        print(\n",
    "            f\"     ✓ Eje: {v['eje_gyro_dom']}/{v['eje_accel_dom']} | Jerk ang: {v['jerk_rms_angular']:.1f} °/s²\"\n",
    "        )\n",
    "        print(\n",
    "            f\"     ✓ FS: {v['fs_real']:.1f} Hz {'⚠️' if v['fs_warning'] else '✓'} | Estado: {'VÁLIDO' if v['valido'] else 'INSUFICIENTE'}\"\n",
    "        )\n",
    "\n",
    "    # Reporte TXT\n",
    "    rep = os.path.join(\n",
    "        config.OUTPUT_BASE,\n",
    "        \"reportes\",\n",
    "        f\"baseline_{os.path.basename(archivo_path)}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt\",\n",
    "    )\n",
    "    os.makedirs(os.path.dirname(rep), exist_ok=True)\n",
    "    with open(rep, \"w\", encoding=\"utf-8\") as f:\n",
    "        f.write(\n",
    "            \"=\" * 80\n",
    "            + \"\\nREPORTE BASELINE – PRONACIÓN-SUPINACIÓN (v2)\\n\"\n",
    "            + \"=\" * 80\n",
    "            + f\"\\n\\nArchivo: {os.path.basename(archivo_path)}\\nTipo: {descripcion}\\nFecha: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\\n\\n\"\n",
    "        )\n",
    "        for did, v in variables_totales.items():\n",
    "            f.write(f\"{'='*40}\\nDISPOSITIVO: {did}\\n{'='*40}\\n\\n\")\n",
    "            f.write(\n",
    "                f\"FS: {v['fs_real']:.1f} Hz {'(⚠️)' if v['fs_warning'] else '(✓)'}\\nEje dom: {v['eje_gyro_dom']}/{v['eje_accel_dom']}\\n\"\n",
    "            )\n",
    "            f.write(f\"Ciclos: {v['n_ciclos']} | Duración: {v['duracion']:.1f} s\\n\")\n",
    "            f.write(\n",
    "                f\"Amplitud: {v['amplitud_media']:.1f}±{v['amplitud_std']:.1f} °/s | Angular: {v['amplitud_angular_media']:.1f}±{v['amplitud_angular_std']:.1f}°\\n\"\n",
    "            )\n",
    "            f.write(\n",
    "                f\"Cadencia: {v['cadencia']:.2f} Hz | Intervalo: {v['intervalo_medio']*1000:.0f} ms | FFT: {v['frecuencia']:.2f} Hz\\n\"\n",
    "            )\n",
    "            f.write(\n",
    "                f\"Regularidad: {v['regularidad']:.1f}% | Compensación: {v['compensacion_lateral']:.3f}\\n\"\n",
    "            )\n",
    "            f.write(\n",
    "                f\"Jerk ang: {v['jerk_rms_angular']:.1f} °/s² | lineal: {v['jerk_rms']:.3f} g/s | RMS acc lat: {v['rms_acc_lateral']:.3f} g\\n\"\n",
    "            )\n",
    "            f.write(f\"Estado: {'VÁLIDO' if v['valido'] else 'INSUFICIENTE'}\\n\\n\")\n",
    "    print(f\"\\n💾 Reporte: {os.path.basename(rep)}\")\n",
    "\n",
    "    # JSON\n",
    "    json_path = os.path.join(config.OUTPUT_SUMMARY, f\"{sujeto_id}_variables.json\")\n",
    "    vs_all = {}\n",
    "    for did, vd in variables_totales.items():\n",
    "        vs = {}\n",
    "        for k, val in vd.items():\n",
    "            if k == \"ciclos_pareados\":\n",
    "                vs[k] = [\n",
    "                    {\n",
    "                        k2: (\n",
    "                            int(v2)\n",
    "                            if isinstance(v2, np.integer)\n",
    "                            else float(v2) if isinstance(v2, np.floating) else v2\n",
    "                        )\n",
    "                        for k2, v2 in c.items()\n",
    "                    }\n",
    "                    for c in val\n",
    "                ]\n",
    "            elif isinstance(val, np.integer):\n",
    "                vs[k] = int(val)\n",
    "            elif isinstance(val, np.floating):\n",
    "                vs[k] = float(val)\n",
    "            elif isinstance(val, np.bool_):\n",
    "                vs[k] = bool(val)\n",
    "            elif isinstance(val, np.ndarray):\n",
    "                vs[k] = val.tolist()\n",
    "            else:\n",
    "                vs[k] = val\n",
    "        vs_all[did] = vs\n",
    "    with open(json_path, \"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(\n",
    "            {\n",
    "                \"archivo\": os.path.basename(archivo_path),\n",
    "                \"tipo_prueba\": tipo_prueba,\n",
    "                \"fecha\": datetime.now().isoformat(),\n",
    "                \"fixes_v2\": [\n",
    "                    \"top_n_post_alternancia\",\n",
    "                    \"rescate_selectivo\",\n",
    "                    \"abs_neg\",\n",
    "                    \"cadencia_real\",\n",
    "                    \"eje_dominante_adaptativo\",\n",
    "                    \"compensacion_no_dominante\",\n",
    "                    \"greedy_bidireccional\",\n",
    "                ],\n",
    "                \"variables\": vs_all,\n",
    "            },\n",
    "            f,\n",
    "            indent=2,\n",
    "            ensure_ascii=False,\n",
    "        )\n",
    "    print(f\"💾 JSON: {os.path.basename(json_path)}\")\n",
    "    print(\"\\n\" + \"=\" * 80 + \"\\nANÁLISIS COMPLETADO\\n\" + \"=\" * 80)\n",
    "    return {\n",
    "        \"archivo\": archivo_path,\n",
    "        \"tipo_prueba\": tipo_prueba,\n",
    "        \"dispositivos\": list(datos_por_disp.keys()),\n",
    "        \"resultados\": resultados,\n",
    "        \"variables_totales\": variables_totales,\n",
    "    }\n",
    "\n",
    "\n",
    "# ========================================\n",
    "# 8-9. PROCESAMIENTO Y EXCEL\n",
    "# ========================================\n",
    "def procesar_entrada(path_entrada, debug=False):\n",
    "    res = []\n",
    "    if os.path.isfile(path_entrada):\n",
    "        print(\"\\n📄 MODO: ARCHIVO ÚNICO\")\n",
    "        r = analisis_baseline_pronacion(path_entrada, debug=debug)\n",
    "        if r:\n",
    "            res.append(r)\n",
    "    elif os.path.isdir(path_entrada):\n",
    "        archivos = sorted(\n",
    "            [\n",
    "                os.path.join(path_entrada, f)\n",
    "                for f in os.listdir(path_entrada)\n",
    "                if f.lower().endswith(\".json\")\n",
    "            ]\n",
    "        )\n",
    "        print(f\"\\n📁 MODO: CARPETA – {len(archivos)} archivos\")\n",
    "        for i, archivo in enumerate(archivos, 1):\n",
    "            print(f\"\\n▶ [{i}/{len(archivos)}]: {os.path.basename(archivo)}\")\n",
    "            try:\n",
    "                r = analisis_baseline_pronacion(archivo, debug=debug)\n",
    "                if r:\n",
    "                    res.append(r)\n",
    "            except Exception as e:\n",
    "                print(f\"   ✗ {e}\")\n",
    "    else:\n",
    "        print(f\"\\n❌ Ruta inválida: {path_entrada}\")\n",
    "    return res\n",
    "\n",
    "\n",
    "def generar_excel_baseline(resultados, output_dir):\n",
    "    filas = []\n",
    "    for r in resultados:\n",
    "        for did, vd in r[\"variables_totales\"].items():\n",
    "            fila = {\n",
    "                \"archivo\": os.path.basename(r[\"archivo\"]),\n",
    "                \"dispositivo\": did,\n",
    "                \"tipo_prueba\": r[\"tipo_prueba\"],\n",
    "                \"valido\": vd[\"valido\"],\n",
    "            }\n",
    "            for k, v in vd.items():\n",
    "                if isinstance(v, (int, float)):\n",
    "                    fila[k] = v\n",
    "            filas.append(fila)\n",
    "    df_raw = pd.DataFrame(filas)\n",
    "    df_val = df_raw[df_raw[\"valido\"] == True]\n",
    "    df_sum = df_val.describe().T if len(df_val) else pd.DataFrame()\n",
    "    if len(df_sum):\n",
    "        df_sum[\"cv\"] = df_sum[\"std\"] / df_sum[\"mean\"]\n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "    ep = os.path.join(\n",
    "        output_dir,\n",
    "        f\"baseline_pronacion_supinacion_{datetime.now().strftime('%Y%m%d_%H%M%S')}.xlsx\",\n",
    "    )\n",
    "    with pd.ExcelWriter(ep, engine=\"xlsxwriter\") as w:\n",
    "        df_raw.to_excel(w, sheet_name=\"raw_metrics\", index=False)\n",
    "        if len(df_sum):\n",
    "            df_sum.to_excel(w, sheet_name=\"baseline_summary\")\n",
    "    print(f\"\\n📊 EXCEL: {ep}\")\n",
    "    return ep\n",
    "\n",
    "\n",
    "# ========================================\n",
    "# PUNTO DE ENTRADA\n",
    "# ========================================\n",
    "if __name__ == \"__main__\":\n",
    "    RUTA_ENTRADA = \"./PRONATION_SUPINATION/Score 0\"\n",
    "\n",
    "    ConfigBaseline.PICO_HEIGHT_FACTOR_POS = 0.10\n",
    "    ConfigBaseline.PICO_HEIGHT_FACTOR_NEG = 0.10\n",
    "    ConfigBaseline.PICO_PROMINENCE_FACTOR = 0.10\n",
    "    ConfigBaseline.PICO_MIN_DISTANCE = 10\n",
    "    ConfigBaseline.N_CICLOS_ESPERADOS = 10\n",
    "    ConfigBaseline.USAR_TOP_N = True\n",
    "    MODO_DEBUG = True\n",
    "\n",
    "    print(\"\\n⚙️  CONFIGURACIÓN (PRONACIÓN-SUPINACIÓN v2):\")\n",
    "    print(f\"   • Ruta        : {RUTA_ENTRADA}\")\n",
    "    print(f\"   • GYRO_LOWCUT : {ConfigBaseline.GYRO_LOWCUT} Hz\")\n",
    "    print(f\"   • Umbral      : {ConfigBaseline.PICO_HEIGHT_FACTOR_POS*100:.0f}%\")\n",
    "    print(\n",
    "        f\"   • Top-N       : {ConfigBaseline.N_CICLOS_ESPERADOS} ciclos (post-alternancia)\"\n",
    "    )\n",
    "    print(f\"   • Fixes v2    : top-N-post-alternancia, rescate-selectivo, abs-neg,\")\n",
    "    print(\n",
    "        f\"                   cadencia-real, eje-adaptativo, compensación-no-dominante\"\n",
    "    )\n",
    "\n",
    "    resultados = procesar_entrada(RUTA_ENTRADA, debug=MODO_DEBUG)\n",
    "\n",
    "    if resultados:\n",
    "        print(\"\\n\" + \"=\" * 80 + \"\\nRESUMEN GLOBAL\\n\" + \"=\" * 80)\n",
    "        td = tok = 0\n",
    "        for r in resultados:\n",
    "            for vd in r[\"variables_totales\"].values():\n",
    "                td += 1\n",
    "                if vd[\"valido\"]:\n",
    "                    tok += 1\n",
    "        print(\n",
    "            f\"Pruebas: {len(resultados)} | Dispositivos: {td} | Válidos: {tok} | Inválidos: {td-tok}\"\n",
    "        )\n",
    "        generar_excel_baseline(resultados, ConfigBaseline.OUTPUT_BASE)"
   ]
  },
