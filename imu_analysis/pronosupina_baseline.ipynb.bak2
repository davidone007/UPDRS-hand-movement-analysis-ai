      "mag                  0.746      0.874      0.157      0.237      0.191       23.65      0.406      1.216   [% Ciclo]\n",
      "angulo_x           -33.611     33.223     10.514     13.910     11.932       50.49    -50.753     50.638   [% Ciclo]\n",
      "jerk_ang         -6471.334   6139.202   1169.405   5587.495   3467.365      163.91 -15239.626  14531.461   [% Ciclo]\n",
      "jerk_lin            -4.080      4.193      2.698      7.087      4.558      302.56    -12.971     12.375   [% Ciclo]\n",
      "fft_mag            932.050  52077.773   1098.374  35427.298   8405.372       69.98     65.022 113218.057   [0-5 Hz]\n",
      "==============================================================================================================\n",
      "(Valores sobre el eje normalizado de cada señal)\n",
      "\n"
     ]
    }
   ],
   "source": [
    "    import matplotlib.pyplot as plt\n",
    "    from scipy.interpolate import interp1d\n",
    "    import numpy as np\n",
    "    import os\n",
    "    import pandas as pd\n",
    "    from scipy.fft import fft, fftfreq\n",
    "\n",
    "    print(\"Construyendo Baseline Dinámica COMPLETA (Todas las curvas del movimiento)...\")\n",
    "\n",
    "    # Variables para acumular las curvas de cada ciclo (normalizadas a 100 puntos)\n",
    "    curvas_dict = {\n",
    "        'gx': [], 'gy': [], 'gz': [],\n",
    "        'ax': [], 'ay': [], 'az': [], 'mag': [],\n",
    "        'angulo_x': [],\n",
    "        'jerk_ang': [],\n",
    "        'jerk_lin': [],\n",
    "        'fft_mag': []  # Añadido para la gráfica de FFT\n",
    "    }\n",
    "\n",
    "    N_PUNTOS = 100\n",
    "    t_norm = np.linspace(0, 100, N_PUNTOS)\n",
    "    f_norm = np.linspace(0, 5, N_PUNTOS) # Frecuencias normalizadas para interpolar FFT de 0 a 5 Hz\n",
    "    dt = 1.0 / 100.0 # Se asume FS=100\n",
    "\n",
    "    for r in resultados_completos:\n",
    "        if \"variables_totales\" not in r: continue\n",
    "        for did, vars_dict in r[\"variables_totales\"].items():\n",
    "            if vars_dict.get(\"valido\", False):\n",
    "                procesado = r[\"resultados\"][did][\"procesado\"]\n",
    "                \n",
    "                picos_pos = vars_dict[\"picos_pos\"]\n",
    "                eje_accel_dom = vars_dict[\"eje_accel_dom\"]\n",
    "                \n",
    "                gx, gy, gz = procesado[\"gx\"], procesado[\"gy\"], procesado[\"gz\"]\n",
    "                ax, ay, az = procesado[\"ax\"], procesado[\"ay\"], procesado[\"az\"]\n",
    "                angulo_x = procesado[\"angulo_x\"]\n",
    "                \n",
    "                mag = np.sqrt(ax**2 + ay**2 + az**2)\n",
    "                # [FIX] jerk angular sobre eje giroscopio dominante real (no gx fijo)\n",
    "                eje_gyro_dom = vars_dict[\"eje_gyro_dom\"]\n",
    "                gyro_map = {\"gx\": gx, \"gy\": gy, \"gz\": gz}\n",
    "                jerk_ang = np.gradient(gyro_map[eje_gyro_dom], dt)\n",
    "                accel_map = {\"ax\": ax, \"ay\": ay, \"az\": az}\n",
    "                jerk_lin = np.gradient(accel_map[eje_accel_dom], dt)\n",
    "                \n",
    "                # Calcular FFT general de este paciente y normalizar a la base de frecuencia\n",
    "                N = len(gx)\n",
    "                yf = fft(gx)\n",
    "                xf = fftfreq(N, dt)[: N // 2]\n",
    "                power = np.abs(yf[: N // 2])\n",
    "                \n",
    "                # Interpolar FFT a f_norm (evitando errores fuera de rango)\n",
    "                if len(xf) > 1:\n",
    "                    interp_fft = interp1d(xf, power, kind='linear', bounds_error=False, fill_value=0)\n",
    "                    curvas_dict['fft_mag'].append(interp_fft(f_norm))\n",
    "                \n",
    "                # Recopilar por ciclo\n",
    "                for i in range(len(picos_pos) - 1):\n",
    "                    inicio = picos_pos[i]\n",
    "                    fin = picos_pos[i+1]\n",
    "                    \n",
    "                    if fin > inicio:\n",
    "                        x_original = np.linspace(0, 100, fin - inicio)\n",
    "                        \n",
    "                        for key, signal in [('gx', gx), ('gy', gy), ('gz', gz),\n",
    "                                            ('ax', ax), ('ay', ay), ('az', az), ('mag', mag),\n",
    "                                            ('angulo_x', angulo_x), ('jerk_ang', jerk_ang), ('jerk_lin', jerk_lin)]:\n",
    "                            \n",
    "                            segmento = signal[inicio:fin]\n",
    "                            interp_func = interp1d(x_original, segmento, kind='cubic')\n",
    "                            norm_sig = interp_func(t_norm)\n",
    "                            \n",
    "                            if key == 'angulo_x':\n",
    "                                norm_sig = norm_sig - np.mean(norm_sig)\n",
    "                                \n",
    "                            curvas_dict[key].append(norm_sig)\n",
    "\n",
    "    for k in curvas_dict.keys():\n",
    "        if len(curvas_dict[k]) > 0:\n",
    "            curvas_dict[k] = np.array(curvas_dict[k])\n",
    "\n",
    "    if len(curvas_dict['gx']) > 0:\n",
    "        print(f\"Total de ciclos válidos procesados: {len(curvas_dict['gx'])}\")\n",
    "        \n",
    "        stats_dict = {}\n",
    "        for k in curvas_dict.keys():\n",
    "            if len(curvas_dict[k]) > 0:\n",
    "                data = curvas_dict[k]\n",
    "                stats_dict[k] = {\n",
    "                    'mean': np.mean(data, axis=0),\n",
    "                    'std': np.std(data, axis=0),\n",
    "                    'p5': np.percentile(data, 5, axis=0),\n",
    "                    'p95': np.percentile(data, 95, axis=0)\n",
    "                }\n",
    "        \n",
    "        fig, axes = plt.subplots(4, 3, figsize=(18, 14))\n",
    "        axes = axes.flatten()\n",
    "        \n",
    "        plot_configs = [\n",
    "            ('gx', 'Giroscopio ωx (°/s)', 'blue'),\n",
    "            ('angulo_x', 'Ángulo Rotación θx (°)', 'purple'),\n",
    "            ('mag', 'Magnitud Aceleración (g)', 'purple'),\n",
    "            ('gy', 'Giroscopio ωy (°/s)', 'green'),\n",
    "            ('ax', 'Acelerómetro ax (g)', 'blue'),\n",
    "            ('fft_mag', 'Espectro FFT Magnitud (0-5Hz)', 'darkred'),\n",
    "            ('gz', 'Giroscopio ωz (°/s)', 'red'),\n",
    "            ('ay', 'Acelerómetro ay (g)', 'green'),\n",
    "            ('jerk_ang', 'Jerk Angular (eje dom) (°/s²)', 'darkorange'),\n",
    "            ('az', 'Acelerómetro az (g)', 'red'),\n",
    "            ('jerk_lin', 'Jerk Lineal dom (g/s)', 'm'),\n",
    "            (None, '', '')\n",
    "        ]\n",
    "        \n",
    "        for i, (key, title, color) in enumerate(plot_configs):\n",
    "            ax = axes[i]\n",
    "            if key is None or key not in stats_dict:\n",
    "                ax.axis('off')\n",
    "                continue\n",
    "                \n",
    "            m = stats_dict[key]['mean']\n",
    "            s = stats_dict[key]['std']\n",
    "            p5 = stats_dict[key]['p5']\n",
    "            p95 = stats_dict[key]['p95']\n",
    "            \n",
    "            x_axis = f_norm if key == 'fft_mag' else t_norm\n",
    "            \n",
    "            ax.fill_between(x_axis, p5, p95, color=color, alpha=0.15, label='Rango Normal (5-95%)')\n",
    "            ax.fill_between(x_axis, m - s, m + s, color=color, alpha=0.3, label='±1 D.E.')\n",
    "            ax.plot(x_axis, m, color=color, lw=2, label='Media')\n",
    "            \n",
    "            if key not in ['mag', 'fft_mag']:\n",
    "                ax.axhline(0, color='black', ls='--', alpha=0.4)\n",
    "                \n",
    "            ax.set_title(f\"Baseline Dinámica: {title}\", fontsize=10, fontweight='bold')\n",
    "            ax.set_xlabel(\"Frecuencia (Hz)\" if key == 'fft_mag' else \"% del Ciclo\")\n",
    "            ax.grid(True, alpha=0.3)\n",
    "            if i == 0:\n",
    "                ax.legend(fontsize=8, loc='upper right')\n",
    "\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "        \n",
    "        # ── Imprimir resumen estadístico de las curvas en consola ──────────────\n",
    "        print(\"\\n\" + \"=\"*110)\n",
    "        print(\"RESUMEN ESTADÍSTICO — CURVAS DE BASELINE DINÁMICA\")\n",
    "        print(\"=\"*110)\n",
    "        print(f\"{'Señal':<15} {'Media_min':>10} {'Media_max':>10} {'DE_min':>10} {'DE_max':>10} {'DE_media':>10} {'CV_media%':>11} {'P5_min':>10} {'P95_max':>10}\")\n",
    "        print(\"-\"*110)\n",
    "        for k, s in stats_dict.items():\n",
    "            etiqueta = \"% Ciclo\" if k != \"fft_mag\" else \"0-5 Hz\"\n",
    "            de_min = float(s['std'].min())\n",
    "            de_max = float(s['std'].max())\n",
    "            de_media = float(s['std'].mean())\n",
    "            media_abs = float(np.mean(np.abs(s['mean'])))\n",
    "            cv_media = (de_media / media_abs * 100.0) if media_abs > 0 else 0.0\n",
    "            print(f\"{k:<15} {s['mean'].min():>10.3f} {s['mean'].max():>10.3f} \"\n",
    "                  f\"{de_min:>10.3f} {de_max:>10.3f} {de_media:>10.3f} {cv_media:>11.2f} \"\n",
    "                  f\"{s['p5'].min():>10.3f} {s['p95'].max():>10.3f}\"\n",
    "                  f\"   [{etiqueta}]\")\n",
    "        print(\"=\"*110)\n",
    "        print(\"(Valores sobre el eje normalizado de cada señal)\\n\")\n",
    "    else:\n",
    "        print(\"No se encontraron ciclos válidos para generar la baseline dinámica.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "JSON exportado en: C:\\Universidad\\Semestre IX\\PDG II\\datosBaseline\\Pronacion Supinacion\\baseline\\summary\\pronation_supination_baseline_full.json\n",
      "Métricas escalares exportadas: 23\n",
      "Métricas de curvas exportadas: 11\n"
     ]
    }
   ],
   "source": [
    "# Exportar JSON unificado: métricas escalares (tabla) + métricas de curvas\n",
    "\n",
    "# Requiere ejecutar primero la celda 2 (df_validos) y la celda 3 (stats_dict).\n",
    "\n",
    "\n",
    "\n",
    "import json\n",
    "\n",
    "from datetime import datetime\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "\n",
    "\n",
    "if 'df_validos' not in globals() or 'stats_dict' not in globals():\n",
    "\n",
    "    raise RuntimeError(\n",
    "\n",
    "        \"Primero ejecuta la celda 2 (df_validos) y la celda 3 (stats_dict) antes de exportar.\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "\n",
    "# Mapeo de columnas de la tabla a claves del JSON final\n",
    "\n",
    "metric_map = {\n",
    "\n",
    "    \"Ciclos Pareados\": \"n_ciclos\",\n",
    "\n",
    "    \"Duración (s)\": \"duracion\",\n",
    "\n",
    "    \"Cadencia (Hz)\": \"cadencia\",\n",
    "\n",
    "    \"Intervalo Medio (s)\": \"intervalo_medio\",\n",
    "\n",
    "    \"Amplitud Media (°/s)\": \"amplitud_media\",\n",
    "\n",
    "    \"Amplitud Estándar (°/s)\": \"amplitud_std\",\n",
    "\n",
    "    \"CV Amplitud\": \"amplitud_cv\",\n",
    "\n",
    "    \"Amplitud Angular Media (°)\": \"amplitud_angular_media\",\n",
    "\n",
    "    \"Amplitud Angular Estándar (°)\": \"amplitud_angular_std\",\n",
    "\n",
    "    \"Rango Angular Total (°)\": \"rango_angular_total\",\n",
    "\n",
    "    \"Velocidad Pico Media (°/s)\": \"velocidad_pico_media\",\n",
    "\n",
    "    \"Velocidad Pico Max (°/s)\": \"velocidad_pico_max\",\n",
    "\n",
    "    \"Velocidad Pico Estándar (°/s)\": \"velocidad_pico_std\",\n",
    "\n",
    "    \"Frecuencia Dominante (Hz)\": \"frecuencia\",\n",
    "\n",
    "    \"Regularidad (%)\": \"regularidad\",\n",
    "\n",
    "    \"Compensación Lateral\": \"compensacion_lateral\",\n",
    "\n",
    "    \"Rango ωx (°/s)\": \"rango_wx\",\n",
    "\n",
    "    \"Rango ωy (°/s)\": \"rango_wy\",\n",
    "\n",
    "    \"Rango ωz (°/s)\": \"rango_wz\",\n",
    "\n",
    "    \"Jerk Angular RMS (°/s²)\": \"jerk_rms_angular\",\n",
    "\n",
    "    \"Jerk Lineal RMS (g/s)\": \"jerk_rms\",\n",
    "\n",
    "    \"RMS Acc Lateral (g)\": \"rms_acc_lateral\",\n",
    "\n",
    "    \"Energía Relativa\": \"energia_relativa_x\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "\n",
    "# Mapeo de señales de curvas a claves del JSON final\n",
    "\n",
    "curve_map = {\n",
    "\n",
    "    \"gx\": \"señal_gx\",\n",
    "\n",
    "    \"gy\": \"señal_gy\",\n",
    "\n",
    "    \"gz\": \"señal_gz\",\n",
    "\n",
    "    \"ax\": \"señal_ax\",\n",
    "\n",
    "    \"ay\": \"señal_ay\",\n",
    "\n",
    "    \"az\": \"señal_az\",\n",
    "\n",
    "    \"mag\": \"señal_mag\",\n",
    "\n",
    "    \"angulo_x\": \"señal_angulo_x\",\n",
    "\n",
    "    \"jerk_ang\": \"señal_jerk_ang\",\n",
    "\n",
    "    \"jerk_lin\": \"señal_jerk_lin\",\n",
    "\n",
    "    \"fft_mag\": \"señal_fft_mag\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "\n",
    "payload = {\n",
    "\n",
    "    \"_meta\": {\n",
    "\n",
    "        \"description\": \"Baseline estadística de sujetos sanos para la prueba de pronación-supinación (MDS-UPDRS 3.6).\",\n",
    "\n",
    "        \"fuente\": \"Prono-Supina.ipynb\",\n",
    "\n",
    "        \"formato\": \"Cada métrica contiene: mean, std, p5, p95 (P5 y P95 definen el rango normal)\",\n",
    "\n",
    "        \"generado\": datetime.now().isoformat(),\n",
    "\n",
    "    },\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "\n",
    "# 1) Métricas escalares (tabla)\n",
    "\n",
    "for col_name, out_key in metric_map.items():\n",
    "\n",
    "    if col_name not in df_validos.columns:\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "\n",
    "    col = df_validos[col_name].dropna().astype(float)\n",
    "\n",
    "    if col.empty:\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "\n",
    "    payload[out_key] = {\n",
    "\n",
    "        \"mean\": float(col.mean()),\n",
    "\n",
    "        \"std\": float(col.std()),\n",
    "\n",
    "        \"p5\": float(col.quantile(0.05)),\n",
    "\n",
    "        \"p95\": float(col.quantile(0.95)),\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "\n",
    "# 2) Métricas de curvas\n",
    "\n",
    "payload[\"_meta_señales\"] = (\n",
    "\n",
    "    \"Envolventes de señal derivadas de curvas baseline dinámicas. \"\n",
    "\n",
    "    \"Para cada señal se exporta: mean=(Media_min+Media_max)/2, std=DE_media, p5=P5_min, p95=P95_max.\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "for curve_key, out_key in curve_map.items():\n",
    "\n",
    "    if curve_key not in stats_dict:\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "\n",
    "    s = stats_dict[curve_key]\n",
    "\n",
    "    mean_arr = s[\"mean\"]\n",
    "\n",
    "    std_arr = s[\"std\"]\n",
    "\n",
    "    p5_arr = s[\"p5\"]\n",
    "\n",
    "    p95_arr = s[\"p95\"]\n",
    "\n",
    "\n",
    "\n",
    "    mean_min = float(mean_arr.min())\n",
    "\n",
    "    mean_max = float(mean_arr.max())\n",
    "\n",
    "    payload[out_key] = {\n",
    "\n",
    "        \"mean\": float((mean_min + mean_max) / 2.0),\n",
    "\n",
    "        \"std\": float(std_arr.mean()),\n",
    "\n",
    "        \"p5\": float(p5_arr.min()),\n",
    "\n",
    "        \"p95\": float(p95_arr.max()),\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "\n",
    "# Guardar JSON\n",
    "\n",
    "output_path = Path(\"./Pronacion Supinacion/baseline/summary/pronation_supination_baseline_full.json\")\n",
    "\n",
    "output_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "\n",
    "\n",
    "with output_path.open(\"w\", encoding=\"utf-8\") as f:\n",
    "\n",
    "    json.dump(payload, f, indent=2, ensure_ascii=False)\n",
    "\n",
    "\n",
    "\n",
    "print(f\"JSON exportado en: {output_path.resolve()}\")\n",
    "\n",
    "print(f\"Métricas escalares exportadas: {len([k for k in payload.keys() if not k.startswith('_') and not k.startswith('señal_')])}\")\n",
    "\n",
    "print(f\"Métricas de curvas exportadas: {len([k for k in payload.keys() if k.startswith('señal_')])}\")"
   ]
  }
 ],
